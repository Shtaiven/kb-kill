[Unit]
Description=kb-kill-push - feed this user's config to the kb-kill daemon
# Pushes over the daemon's control socket and reconnects on its own, so no
# ordering dependency on the system daemon is needed. Not for system accounts
# (the login greeter has no config to push).
ConditionUser=!@system

[Service]
Type=simple
ExecStart=/usr/local/bin/kb-kill-push
Restart=on-failure
RestartSec=2

[Install]
# default.target, not graphical-session.target: the daemon follows the active
# seat user on a TTY too.
WantedBy=default.target
