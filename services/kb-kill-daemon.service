[Unit]
Description=kb-kill - disable/enable target input devices on a global hotkey
After=multi-user.target

[Service]
Type=simple
# Config-less: each session's kb-kill-push feeds the active user's config over
# the control socket in $RUNTIME_DIRECTORY (/run/kb-kill).
ExecStart=/usr/local/bin/kb-kill-daemon
Restart=on-failure
RestartSec=2

# Not root. Everything the daemon does needs only read/write on
# /dev/input/event* (group input): open, read, EVIOCGKEY, EVIOCSMASK, EVIOCGRAB.
# Never add a login user to group input; that hands every process they run the
# ability to read all keystrokes, which this single sandboxed daemon exists to
# avoid.
DynamicUser=yes
SupplementaryGroups=input
RuntimeDirectory=kb-kill
RuntimeDirectoryMode=0755

# Journal. Readable by group adm/wheel, and any local uid may push a config, so
# the daemon writes nothing at key-event rate and rate-limits state lines
# (see README "Security model"). StandardError must be explicit: its default
# `inherit` would follow StandardOutput=null and silence the journal.
StandardOutput=null
StandardError=journal
SyslogLevelPrefix=yes
SyslogIdentifier=kb-kill-daemon

# Sandbox. No capabilities, no network, only input device nodes.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
DevicePolicy=closed
DeviceAllow=char-input rw
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
