#!/usr/bin/env python3
"""kb-kill-tray - tray icon (StatusNotifierItem / AppIndicator) for kb-kill.

Shows whether each group is KILLED or AWAKE and toggles a group from its menu
entry, over the daemon's control socket. Runs as the user; needs PyGObject with
Gtk 3 and AyatanaAppIndicator3 (or the legacy AppIndicator3).
"""

# pyright: reportMissingImports=false

import json
import os
import shutil
import socket
import subprocess
import sys

# Rewritten by packaging/bump-version.sh from the repo-root VERSION file.
VERSION = "0.4.1"

if __name__ == "__main__" and sys.argv[1:] and sys.argv[1] in ("-V", "--version"):
    print(f"kb-kill-tray {VERSION} ({os.path.realpath(__file__)})")
    sys.exit(0)

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
try:
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3 as AppIndicator3
except (ValueError, ImportError):
    try:
        gi.require_version("AppIndicator3", "0.1")
        from gi.repository import AppIndicator3
    except (ValueError, ImportError):
        sys.exit(
            "kb-kill-tray: AppIndicator typelib not found "
            "(Debian/Ubuntu: gir1.2-ayatanaappindicator3-0.1, Arch: libayatana-appindicator)"
        )
from gi.repository import GLib, Gtk  # noqa: E402

APP_ID = "kb-kill"
ICON_AWAKE, ICON_KILLED = "kb-kill-awake", "kb-kill-killed"
RECONNECT_SECONDS = 2
HERE = os.path.dirname(os.path.realpath(__file__))


def icon_dir() -> str | None:
    for candidate in (
        os.path.join(HERE, os.pardir, "icons"),  # git checkout
        "/usr/local/share/kb-kill/icons",  # install.sh
        "/usr/share/kb-kill/icons",  # deb/rpm/AUR
    ):
        if os.path.isdir(candidate):
            return candidate
    return None


def socket_path() -> str:
    candidates = ["/run/kb-kill/control.sock"]
    if base := os.environ.get("XDG_RUNTIME_DIR"):
        candidates.append(os.path.join(base, "kb-kill.sock"))
    candidates.append(f"/tmp/kb-kill-{os.getuid()}.sock")
    return next((c for c in candidates if os.path.exists(c)), candidates[0])


def user_config_path() -> str:
    return os.path.expanduser(
        os.environ.get("KB_KILL_CONFIG") or "~/.config/kb-kill/kb-kill.toml"
    )


class Tray:
    def __init__(self) -> None:
        self.ind = AppIndicator3.Indicator.new(
            APP_ID, ICON_AWAKE, AppIndicator3.IndicatorCategory.HARDWARE
        )
        if icons := icon_dir():
            self.ind.set_icon_theme_path(icons)
        self.ind.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.sock: socket.socket | None = None
        self.buf = b""
        self.groups: list[dict] = []
        self.connected = False
        # Menu items are built once per group list and updated in place: replacing
        # the Gtk.Menu re-exports the dbusmenu layout, and a shell mid-repaint can
        # keep showing the old checkmarks.
        self._menu_key: tuple | None = None
        self._items: dict[str, Gtk.CheckMenuItem] = {}
        self._handlers: dict[str, int] = {}
        self._icon: str | None = None
        self._render_queued = False
        self._render()
        self._connect()

    # -- connection ----------------------------------------------------------- #
    def _connect(self) -> bool:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(socket_path())
        except OSError:
            s.close()
            self._drop()
            return False
        s.setblocking(False)
        self.sock, self.buf, self.connected = s, b"", True
        GLib.io_add_watch(
            s.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._on_readable
        )
        self._send({"cmd": "status"})
        return True

    def _drop(self) -> None:
        if self.sock is not None:
            self.sock.close()
        self.sock, self.connected = None, False
        self._schedule_render()
        GLib.timeout_add_seconds(RECONNECT_SECONDS, self._reconnect)

    def _reconnect(self) -> bool:
        if not self.connected:
            self._connect()
        return False  # one-shot timer

    def _on_readable(self, fd: int, condition: int) -> bool:
        if condition & (GLib.IO_HUP | GLib.IO_ERR) or self.sock is None:
            self._drop()
            return False
        try:
            data = self.sock.recv(4096)
        except OSError:
            data = b""
        if not data:
            self._drop()
            return False
        *lines, self.buf = (self.buf + data).split(b"\n")
        for line in lines:
            try:
                msg = json.loads(line) if line.strip() else None
            except ValueError:
                continue
            if isinstance(msg, dict) and msg.get("type") == "state":
                self.groups = msg.get("groups", [])
                self._schedule_render()
        return True

    def _send(self, obj: dict[str, str]) -> None:
        if self.sock is None:
            return
        try:
            self.sock.sendall((json.dumps(obj) + "\n").encode())
        except OSError:
            self._drop()

    # -- UI ------------------------------------------------------------------- #
    def _schedule_render(self) -> None:
        """Coalesce a burst of state messages into one UI update."""
        if not self._render_queued:
            self._render_queued = True
            GLib.idle_add(self._render_idle)

    def _render_idle(self) -> bool:
        self._render_queued = False
        self._render()
        return False

    def _render(self) -> None:
        killed = [g.get("label") or g["name"] for g in self.groups if g.get("killed")]
        icon = ICON_KILLED if killed else ICON_AWAKE
        if icon != self._icon:
            self._icon = icon
            self.ind.set_icon_full(icon, "kb-kill")
        if not self.connected:
            self.ind.set_title("kb-kill: connecting…")
        elif killed:
            self.ind.set_title("kb-kill: KILLED " + ", ".join(killed))
        else:
            self.ind.set_title("kb-kill: AWAKE")
        key = (self.connected, tuple((g["name"], g.get("label")) for g in self.groups))
        if key != self._menu_key:
            self._menu_key = key
            self.ind.set_menu(self._build_menu())
        else:
            self._sync_items()

    def _sync_items(self) -> None:
        """Point the check items at the daemon's state without echoing a command."""
        for g in self.groups:
            item = self._items.get(g["name"])
            want = not g.get("killed")
            if item is None or item.get_active() == want:
                continue
            hid = self._handlers[g["name"]]
            item.handler_block(hid)
            item.set_active(want)
            item.handler_unblock(hid)

    def _build_menu(self) -> Gtk.Menu:
        menu = Gtk.Menu()
        self._items, self._handlers = {}, {}
        if not self.connected:
            item = Gtk.MenuItem(label="Connecting to kb-kill service…")
            item.set_sensitive(False)
            menu.append(item)
        elif not self.groups:
            item = Gtk.MenuItem(label="No groups configured")
            item.set_sensitive(False)
            menu.append(item)
        for g in self.groups if self.connected else []:
            # dbusmenu renders a CheckMenuItem as a checkmark toggle: checked = AWAKE.
            item = Gtk.CheckMenuItem(label=g.get("label") or g["name"])
            item.set_active(not g.get("killed"))
            self._handlers[g["name"]] = item.connect(
                "toggled", self._on_toggle, g["name"]
            )
            self._items[g["name"]] = item
            menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        open_item = Gtk.MenuItem(label="Open config…")
        open_item.connect("activate", self._on_open_config)
        menu.append(open_item)
        quit_item = Gtk.MenuItem(label="Quit tray")
        quit_item.connect("activate", lambda _i: Gtk.main_quit())
        menu.append(quit_item)
        menu.show_all()
        return menu

    def _on_toggle(self, item: Gtk.CheckMenuItem, name: str) -> None:
        # Absolute kill/wake (not toggle), so a checkmark that drifted from the
        # daemon resyncs on the first click; status makes the daemon restate itself.
        self._send({"cmd": "wake" if item.get_active() else "kill", "group": name})
        self._send({"cmd": "status"})

    # -- config --------------------------------------------------------------- #
    def _on_open_config(self, _item: object) -> None:
        path = user_config_path()
        if not os.path.exists(path):
            try:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                seed = next(
                    (
                        c
                        for c in (
                            "/etc/kb-kill/kb-kill.toml",
                            os.path.join(HERE, os.pardir, "kb-kill.toml"),
                        )
                        if os.path.isfile(c)
                    ),
                    None,
                )
                if seed:
                    shutil.copyfile(seed, path)
                else:
                    open(path, "a").close()
            except OSError as e:
                sys.stderr.write(f"kb-kill-tray: cannot create {path}: {e}\n")
                return
        self._launch_editor(path)

    @staticmethod
    def _launch_editor(path: str) -> None:
        """Resolve the editor ourselves: xdg-open has no association for
        application/toml and may fall back to the browser."""
        desktop = ""
        for mime in ("application/toml", "text/plain"):
            try:
                desktop = subprocess.run(
                    ["xdg-mime", "query", "default", mime],
                    capture_output=True,
                    text=True,
                ).stdout.strip()
            except OSError:
                desktop = ""
            if desktop:
                break
        cmd = ["gtk-launch", desktop, path] if desktop else ["xdg-open", path]
        try:
            subprocess.Popen(cmd, start_new_session=True)
        except OSError as e:
            sys.stderr.write(f"kb-kill-tray: could not open {path}: {e}\n")


def main() -> int:
    Tray()
    try:
        Gtk.main()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
