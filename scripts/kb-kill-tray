#!/usr/bin/env python3
"""kb-kill-tray - tray icon (StatusNotifierItem / AppIndicator) for kb-kill.

Shows whether each group is KILLED or AWAKE and toggles a group from its menu
entry, over the daemon's control socket. Runs as the user; needs PyGObject with
Gtk 3 and AyatanaAppIndicator3 (or the legacy AppIndicator3). On a toggle it
also flashes an on-screen display, which the menu turns on and off (on by
default) and gtk-layer-shell provides outside GNOME/KDE.
"""

# pyright: reportMissingImports=false

import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tomllib
from collections.abc import Callable

# Rewritten by packaging/bump-version.sh from the repo-root VERSION file.
VERSION = "0.5.0"

if __name__ == "__main__" and sys.argv[1:] and sys.argv[1] in ("-V", "--version"):
    print(f"kb-kill-tray {VERSION} ({os.path.realpath(__file__)})")
    sys.exit(0)

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
try:
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3 as AppIndicator3
except (ValueError, ImportError):
    try:
        gi.require_version("AppIndicator3", "0.1")
        from gi.repository import AppIndicator3
    except (ValueError, ImportError):
        sys.exit(
            "kb-kill-tray: AppIndicator typelib not found "
            "(Debian/Ubuntu: gir1.2-ayatanaappindicator3-0.1, Arch: libayatana-appindicator)"
        )
from gi.repository import Gio, GLib, Gtk  # noqa: E402

APP_ID = "kb-kill"
ICON_AWAKE, ICON_KILLED = "kb-kill-awake", "kb-kill-killed"
RECONNECT_SECONDS = 2
HERE = os.path.dirname(os.path.realpath(__file__))


def icon_dir() -> str | None:
    for candidate in (
        os.path.join(HERE, os.pardir, "icons"),  # git checkout
        "/usr/local/share/kb-kill/icons",  # install.sh
        "/usr/share/kb-kill/icons",  # deb/rpm/AUR
    ):
        if os.path.isdir(candidate):
            return candidate
    return None


def socket_path() -> str:
    candidates = ["/run/kb-kill/control.sock"]
    if base := os.environ.get("XDG_RUNTIME_DIR"):
        candidates.append(os.path.join(base, "kb-kill.sock"))
    candidates.append(f"/tmp/kb-kill-{os.getuid()}.sock")
    return next((c for c in candidates if os.path.exists(c)), candidates[0])


def user_config_path() -> str:
    return os.path.expanduser(
        os.environ.get("KB_KILL_CONFIG") or "~/.config/kb-kill/kb-kill.toml"
    )


# -- on-screen display -------------------------------------------------------- #
OSD_SECONDS = 1.6
OSD_MARGIN = 96  # px clear of the bottom edge, so a dock does not cover it
OSD_MARGIN_MAX = 2000  # a typo in the config must not park the OSD off-screen
OSD_OPACITY = 0.92
OSD_COALESCE_MS = 120  # one hotkey, one stack -- see Tray._osd_for_changes
OSD_ICON = {True: ICON_KILLED, False: ICON_AWAKE}
OSD_RADIUS = 18  # px, for a desktop that publishes no corner radius of its own
# Named theme colours, so the card follows the desktop's light/dark setting.
# Every GTK theme defines these, and GTK falls back to Adwaita, which does too.
OSD_CSS = """
.kb-kill-osd-row {
  background-color: alpha(@theme_bg_color, %(opacity).2f);
  color: @theme_fg_color;
  border: 1px solid alpha(@theme_fg_color, 0.12);
  border-radius: %(radius)dpx;
  padding: 14px 22px;
}
"""


def tray_config_path() -> str:
    """The tray's own settings, kept out of the config that is pushed to the
    daemon: the daemon would only warn about keys it does not know."""
    return os.path.expanduser("~/.config/kb-kill/tray.toml")


def load_settings() -> tuple[bool, int, float]:
    """Defaults for whatever the file leaves out, gets wrong or puts out of
    range: a hand-edited file is never a reason to leave the tray silent."""
    enabled, margin, opacity = True, OSD_MARGIN, OSD_OPACITY
    try:
        with open(tray_config_path(), "rb") as fh:
            doc = tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError, ValueError):
        return enabled, margin, opacity
    enabled = bool(doc.get("osd", enabled))
    raw_margin, raw_opacity = doc.get("osd_margin"), doc.get("osd_opacity")
    if isinstance(raw_margin, int | float) and not isinstance(raw_margin, bool):
        margin = max(0, min(round(raw_margin), OSD_MARGIN_MAX))
    if isinstance(raw_opacity, int | float) and not isinstance(raw_opacity, bool):
        opacity = max(0.0, min(float(raw_opacity), 1.0))
    return enabled, margin, opacity


def save_settings(enabled: bool, margin: int, opacity: float) -> None:
    """Writes every key, so the menu's toggle never drops a hand-edited one."""
    path = tray_config_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as fh:
            fh.write(
                "# kb-kill-tray settings. The tray menu writes this file; the\n"
                "# geometry keys are yours to edit and apply at the next start.\n"
                f"osd = {str(enabled).lower()}\n"
                f"osd_margin = {margin}  # px above the bottom of the screen\n"
                f"osd_opacity = {opacity:.2f}  # 0.0 clear .. 1.0 solid\n"
            )
    except OSError as e:
        sys.stderr.write(f"kb-kill-tray: cannot write {path}: {e}\n")


def corner_radius() -> int:
    """COSMIC keeps its corner radii in its own config and exports none of them
    to GTK, so read the container radius from there; every other desktop we draw
    on publishes nothing, hence the fallback. Read once, when the window is
    built: a radius changed mid-session lands at the next tray restart."""
    for mode in ("Dark", "Light"):
        path = os.path.expanduser(
            f"~/.config/cosmic/com.system76.CosmicTheme.{mode}/v1/corner_radii"
        )
        try:
            with open(path) as fh:
                found = re.search(r"radius_m:\s*\(\s*([0-9.]+)", fh.read())
        except OSError:
            continue
        if found:
            return round(float(found.group(1)))
    return OSD_RADIUS


def _osd_summary(entries: list[tuple[bool, str]]) -> tuple[str, str]:
    """GNOME and KDE each own one OSD widget: fold the stack into one line."""
    return OSD_ICON[any(killed for killed, _ in entries)], " · ".join(
        text for _, text in entries
    )


class Osd:
    """The transient "<group> KILLED" popup, the volume/airplane-mode kind.

    No cross-desktop protocol for this exists. GNOME and KDE each expose their
    own shell OSD on the session bus; everywhere else (COSMIC, wlroots) we draw
    a layer-shell surface ourselves -- which is exactly why GNOME needs the
    D-Bus call, mutter has no layer-shell. Nothing available means no popup:
    the tray icon stays the source of truth.
    """

    def __init__(self) -> None:
        self.enabled, self._margin, self._opacity = load_settings()
        if icons := icon_dir():
            # Our own window resolves ICON_* through the theme, not a set path.
            Gtk.IconTheme.get_default().append_search_path(icons)
        self._bus: Gio.DBusConnection | None = None
        self._backend: Callable[[list[tuple[bool, str]]], None] | None = None
        self._searched = False
        self._win: Gtk.Window | None = None
        self._rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self._timer = 0

    def available(self) -> bool:
        """Probed once; a failed call re-arms the search (see _call)."""
        if self._backend is None and not self._searched:
            self._searched, self._backend = True, self._pick()
        return self._backend is not None

    def show(self, entries: list[tuple[bool, str]]) -> None:
        """One card per entry, stacked. The shell-provided OSDs own a single
        widget, so there they collapse into one line instead."""
        if entries and self.enabled and self.available() and self._backend is not None:
            self._backend(entries)

    # -- backend selection ---------------------------------------------------- #
    def _pick(self) -> Callable[[list[tuple[bool, str]]], None] | None:
        try:
            self._bus = self._bus or Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            return None
        for name, backend in (
            ("org.gnome.Shell", self._gnome),
            ("org.kde.plasmashell", self._kde),
        ):
            if self._owned(name):
                return backend
        try:
            gi.require_version("GtkLayerShell", "0.1")
            from gi.repository import GtkLayerShell  # noqa: F401
        except (ValueError, ImportError):
            return None
        return self._layer

    def _owned(self, name: str) -> bool:
        if self._bus is None:
            return False
        try:
            has_owner = self._bus.call_sync(
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "NameHasOwner",
                GLib.Variant("(s)", (name,)),
                GLib.VariantType("(b)"),
                Gio.DBusCallFlags.NONE,
                1000,
                None,
            )
        except GLib.Error:
            return False
        return bool(has_owner[0])

    # -- shell-provided OSDs -------------------------------------------------- #
    def _call(self, dest: str, path: str, iface: str, method: str, args) -> None:
        def done(bus: Gio.DBusConnection, res: Gio.AsyncResult) -> None:
            try:
                bus.call_finish(res)
            except GLib.Error:
                # Shell restarted or refused the call: look for a backend again.
                self._backend, self._searched = None, False

        if self._bus is None:
            return
        self._bus.call(
            dest,
            path,
            iface,
            method,
            args,
            None,
            Gio.DBusCallFlags.NO_AUTO_START,
            1000,
            None,
            done,
        )

    def _gnome(self, entries: list[tuple[bool, str]]) -> None:
        icon, text = _osd_summary(entries)
        params = {"icon": GLib.Variant("s", icon), "label": GLib.Variant("s", text)}
        self._call(
            "org.gnome.Shell",
            "/org/gnome/Shell",
            "org.gnome.Shell",
            "ShowOSD",
            GLib.Variant("(a{sv})", (params,)),
        )

    def _kde(self, entries: list[tuple[bool, str]]) -> None:
        icon, text = _osd_summary(entries)
        self._call(
            "org.kde.plasmashell",
            "/org/kde/osdService",
            "org.kde.osdService",
            "showText",
            GLib.Variant("(ss)", (icon, text)),
        )

    # -- our own layer-shell surface ------------------------------------------ #
    def _layer(self, entries: list[tuple[bool, str]]) -> None:
        win = self._win = self._win or self._build_window()
        for card in self._rows.get_children():
            card.destroy()
        size = Gtk.IconSize.DIALOG if len(entries) == 1 else Gtk.IconSize.DND
        for killed, text in entries:
            label = Gtk.Label(label=text)
            label.set_line_wrap(True)
            card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            card.get_style_context().add_class("kb-kill-osd-row")
            card.set_halign(Gtk.Align.CENTER)  # each card only as wide as it needs
            card.pack_start(
                Gtk.Image.new_from_icon_name(OSD_ICON[killed], size), False, False, 0
            )
            card.pack_start(label, False, False, 0)
            self._rows.pack_start(card, False, False, 0)
        # A layer surface is sized from the minimum request, and a wrapping
        # label's minimum is one word wide -- ask for the natural width, or every
        # card comes out a narrow column of wrapped text. Realize first: an
        # unrealized label has no font to measure with and reports 0. The daemon
        # caps a label at LABEL_MAX_LEN, so this cannot outgrow the screen.
        win.realize()
        self._rows.show_all()
        win.set_size_request(self._rows.get_preferred_width()[1], -1)
        win.show_all()
        if self._timer:
            GLib.source_remove(self._timer)
        self._timer = GLib.timeout_add(int(OSD_SECONDS * 1000), self._hide)

    def _hide(self) -> bool:
        self._timer = 0
        if self._win is not None:
            self._win.hide()
        return False  # one-shot timer

    def _build_window(self) -> Gtk.Window:
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import GtkLayerShell as gls  # _pick proved it imports

        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_app_paintable(True)
        if visual := win.get_screen().get_rgba_visual():
            win.set_visual(visual)
        provider = Gtk.CssProvider()
        css = OSD_CSS % {"opacity": self._opacity, "radius": corner_radius()}
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            win.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        win.add(self._rows)
        # Overlay layer, no exclusive zone, no keyboard: an OSD, not a panel.
        gls.init_for_window(win)
        gls.set_namespace(win, "kb-kill-osd")
        gls.set_layer(win, gls.Layer.OVERLAY)
        gls.set_anchor(win, gls.Edge.BOTTOM, True)
        gls.set_margin(win, gls.Edge.BOTTOM, self._margin)
        gls.set_keyboard_mode(win, gls.KeyboardMode.NONE)
        win.connect("realize", self._pass_through)
        return win

    @staticmethod
    def _pass_through(win: Gtk.Window) -> None:
        """Empty input region: clicks go to whatever is underneath."""
        try:
            import cairo

            win.get_window().input_shape_combine_region(cairo.Region(), 0, 0)
        except (ImportError, AttributeError):
            pass


class Tray:
    def __init__(self) -> None:
        self.ind = AppIndicator3.Indicator.new(
            APP_ID, ICON_AWAKE, AppIndicator3.IndicatorCategory.HARDWARE
        )
        if icons := icon_dir():
            self.ind.set_icon_theme_path(icons)
        self.ind.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.sock: socket.socket | None = None
        self.buf = b""
        self.groups: list[dict] = []
        self.connected = False
        # Menu items are built once per group list and updated in place: replacing
        # the Gtk.Menu re-exports the dbusmenu layout, and a shell mid-repaint can
        # keep showing the old checkmarks.
        self._menu_key: tuple | None = None
        self._items: dict[str, Gtk.CheckMenuItem] = {}
        self._handlers: dict[str, int] = {}
        self._icon: str | None = None
        self._render_queued = False
        self.osd = Osd()
        self._killed: dict[str, bool] | None = None
        self._pending: dict[str, bool] = {}
        self._osd_timer = 0
        self._render()
        self._connect()

    # -- connection ----------------------------------------------------------- #
    def _connect(self) -> bool:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(socket_path())
        except OSError:
            s.close()
            self._drop()
            return False
        s.setblocking(False)
        self.sock, self.buf, self.connected = s, b"", True
        GLib.io_add_watch(
            s.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._on_readable
        )
        self._send({"cmd": "status"})
        return True

    def _drop(self) -> None:
        if self.sock is not None:
            self.sock.close()
        self.sock, self.connected = None, False
        self._killed = None  # the next snapshot is a baseline, not a toggle
        self._schedule_render()
        GLib.timeout_add_seconds(RECONNECT_SECONDS, self._reconnect)

    def _reconnect(self) -> bool:
        if not self.connected:
            self._connect()
        return False  # one-shot timer

    def _on_readable(self, fd: int, condition: int) -> bool:
        if condition & (GLib.IO_HUP | GLib.IO_ERR) or self.sock is None:
            self._drop()
            return False
        try:
            data = self.sock.recv(4096)
        except OSError:
            data = b""
        if not data:
            self._drop()
            return False
        *lines, self.buf = (self.buf + data).split(b"\n")
        for line in lines:
            try:
                msg = json.loads(line) if line.strip() else None
            except ValueError:
                continue
            if isinstance(msg, dict) and msg.get("type") == "state":
                self.groups = msg.get("groups", [])
                self._osd_for_changes()
                self._schedule_render()
        return True

    def _send(self, obj: dict[str, str]) -> None:
        if self.sock is None:
            return
        try:
            self.sock.sendall((json.dumps(obj) + "\n").encode())
        except OSError:
            self._drop()

    # -- UI ------------------------------------------------------------------- #
    def _osd_for_changes(self) -> None:
        """Collect the groups whose state really flipped. The first state after a
        (re)connect is the daemon restating itself, not a toggle, so it only seeds
        the baseline; so does a group that just appeared.

        One hotkey can flip several groups and the daemon broadcasts each edge on
        its own, so hold the changes briefly and show them as one stack -- popping
        per message would leave only the last one visible."""
        was, self._killed = (
            self._killed,
            {g["name"]: bool(g.get("killed")) for g in self.groups},
        )
        if was is None:
            return
        for name, killed in self._killed.items():
            if was.get(name, killed) != killed:
                self._pending[name] = killed
        if self._pending and not self._osd_timer:
            self._osd_timer = GLib.timeout_add(OSD_COALESCE_MS, self._flush_osd)

    def _flush_osd(self) -> bool:
        self._osd_timer = 0
        pending, self._pending = self._pending, {}
        self.osd.show(
            [
                (
                    pending[g["name"]],
                    f"{g.get('label') or g['name']} "
                    f"{'KILLED' if pending[g['name']] else 'AWAKE'}",
                )
                for g in self.groups
                if g["name"] in pending
            ]
        )
        return False  # one-shot timer

    def _schedule_render(self) -> None:
        """Coalesce a burst of state messages into one UI update."""
        if not self._render_queued:
            self._render_queued = True
            GLib.idle_add(self._render_idle)

    def _render_idle(self) -> bool:
        self._render_queued = False
        self._render()
        return False

    def _render(self) -> None:
        killed = [g.get("label") or g["name"] for g in self.groups if g.get("killed")]
        icon = ICON_KILLED if killed else ICON_AWAKE
        if icon != self._icon:
            self._icon = icon
            self.ind.set_icon_full(icon, "kb-kill")
        if not self.connected:
            self.ind.set_title("kb-kill: connecting…")
        elif killed:
            self.ind.set_title("kb-kill: KILLED " + ", ".join(killed))
        else:
            self.ind.set_title("kb-kill: AWAKE")
        key = (self.connected, tuple((g["name"], g.get("label")) for g in self.groups))
        if key != self._menu_key:
            self._menu_key = key
            self.ind.set_menu(self._build_menu())
        else:
            self._sync_items()

    def _sync_items(self) -> None:
        """Point the check items at the daemon's state without echoing a command."""
        for g in self.groups:
            item = self._items.get(g["name"])
            want = not g.get("killed")
            if item is None or item.get_active() == want:
                continue
            hid = self._handlers[g["name"]]
            item.handler_block(hid)
            item.set_active(want)
            item.handler_unblock(hid)

    def _build_menu(self) -> Gtk.Menu:
        menu = Gtk.Menu()
        self._items, self._handlers = {}, {}
        if not self.connected:
            item = Gtk.MenuItem(label="Connecting to kb-kill service…")
            item.set_sensitive(False)
            menu.append(item)
        elif not self.groups:
            item = Gtk.MenuItem(label="No groups configured")
            item.set_sensitive(False)
            menu.append(item)
        for g in self.groups if self.connected else []:
            # dbusmenu renders a CheckMenuItem as a checkmark toggle: checked = AWAKE.
            item = Gtk.CheckMenuItem(label=g.get("label") or g["name"])
            item.set_active(not g.get("killed"))
            self._handlers[g["name"]] = item.connect(
                "toggled", self._on_toggle, g["name"]
            )
            self._items[g["name"]] = item
            menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        osd_item = Gtk.CheckMenuItem(label="On-screen display")
        if self.osd.available():
            osd_item.set_active(self.osd.enabled)
        else:
            osd_item.set_label("On-screen display (unavailable)")
            osd_item.set_sensitive(False)
        osd_item.connect("toggled", self._on_toggle_osd)
        menu.append(osd_item)
        groups_item = Gtk.MenuItem(label="Edit groups & hotkeys…")
        groups_item.connect("activate", self._on_open_config)
        menu.append(groups_item)
        tray_item = Gtk.MenuItem(label="Edit tray settings…")
        tray_item.connect("activate", self._on_open_tray_config)
        menu.append(tray_item)
        quit_item = Gtk.MenuItem(label="Quit tray")
        quit_item.connect("activate", lambda _i: Gtk.main_quit())
        menu.append(quit_item)
        menu.show_all()
        return menu

    def _on_toggle(self, item: Gtk.CheckMenuItem, name: str) -> None:
        # Absolute kill/wake (not toggle), so a checkmark that drifted from the
        # daemon resyncs on the first click; status makes the daemon restate itself.
        self._send({"cmd": "wake" if item.get_active() else "kill", "group": name})
        self._send({"cmd": "status"})

    def _on_toggle_osd(self, item: Gtk.CheckMenuItem) -> None:
        self.osd.enabled = item.get_active()
        _, margin, opacity = load_settings()  # keep hand-edited geometry
        save_settings(self.osd.enabled, margin, opacity)
        if self.osd.enabled:
            self.osd.show([(False, "On-screen display enabled")])

    # -- config --------------------------------------------------------------- #
    def _on_open_tray_config(self, _item: object) -> None:
        """The tray's own file. Seed it from the running values first, so it
        opens as a documented template rather than an empty buffer."""
        path = tray_config_path()
        if not os.path.exists(path):
            save_settings(*load_settings())
            if not os.path.exists(path):
                return  # save_settings already said why
        self._launch_editor(path)

    def _on_open_config(self, _item: object) -> None:
        path = user_config_path()
        if not os.path.exists(path):
            try:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                seed = next(
                    (
                        c
                        for c in (
                            "/etc/kb-kill/kb-kill.toml",
                            os.path.join(HERE, os.pardir, "kb-kill.toml"),
                        )
                        if os.path.isfile(c)
                    ),
                    None,
                )
                if seed:
                    shutil.copyfile(seed, path)
                else:
                    open(path, "a").close()
            except OSError as e:
                sys.stderr.write(f"kb-kill-tray: cannot create {path}: {e}\n")
                return
        self._launch_editor(path)

    @staticmethod
    def _launch_editor(path: str) -> None:
        """Resolve the editor ourselves: xdg-open has no association for
        application/toml and may fall back to the browser."""
        desktop = ""
        for mime in ("application/toml", "text/plain"):
            try:
                desktop = subprocess.run(
                    ["xdg-mime", "query", "default", mime],
                    capture_output=True,
                    text=True,
                ).stdout.strip()
            except OSError:
                desktop = ""
            if desktop:
                break
        cmd = ["gtk-launch", desktop, path] if desktop else ["xdg-open", path]
        try:
            subprocess.Popen(cmd, start_new_session=True)
        except OSError as e:
            sys.stderr.write(f"kb-kill-tray: could not open {path}: {e}\n")


def main() -> int:
    Tray()
    try:
        Gtk.main()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
