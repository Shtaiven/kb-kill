#!/usr/bin/env python3
"""kb-kill-push - hand the kb-kill daemon this user's config.

One instance per logged-in user. Reads the user's config file, pushes its text
over the daemon's control socket, re-pushes on every edit and reconnects if the
socket drops. The daemon binds the config to this process's uid (SO_PEERCRED)
and applies it only while this user controls the seat. Stdlib only.

When a group sets wake_on_lock, it also tells the daemon when this user's
screen locks and unlocks. Lockers report that to logind in different ways, so
any of these counts as a lock: the session's Lock signal and its LockedHint
turning true; and as an unlock: the session's Unlock signal and LockedHint
turning false. Sleep is not a lock: a desktop that locks on suspend says so
with one of these, and one that does not leaves the kill as it was. COSMIC sets
no LockedHint and tells logind nothing on unlock; its locker keeps
$XDG_RUNTIME_DIR/cosmic-greeter-<session id>.lock while the screen is locked,
so that file appearing and vanishing counts too. It listens with
`gdbus monitor` (GLib), the daemon's sandbox has no D-Bus.
"""

import json
import os
import select
import shutil
import socket
import stat
import subprocess
import sys
import time
import tomllib
from pathlib import Path

POLL_SECONDS = 1.0
RECONNECT_SECONDS = 2.0
LOGIN1 = "/org/freedesktop/login1"
LOCK_RETRY_SECONDS = 30.0  # gdbus died: try again this much later

# Rewritten by packaging/bump-version.sh from the repo-root VERSION file.
VERSION = "0.6.0"


def log(msg: str) -> None:
    sys.stderr.write(f"kb-kill-push: {msg}\n")
    sys.stderr.flush()


def config_path() -> Path | None:
    if env := os.environ.get("KB_KILL_CONFIG"):
        return Path(env).expanduser()
    for p in (
        Path.home() / ".config/kb-kill/kb-kill.toml",
        Path("/etc/kb-kill/kb-kill.toml"),
    ):
        if p.is_file():
            return p
    return None


def socket_path() -> str:
    """The daemon's socket. /run/kb-kill (made by systemd) and
    $XDG_RUNTIME_DIR (private to this user) are used as found. The /tmp
    fallback of a dev daemon only when this user owns it: anyone can create a
    file there, and would then read what is sent and answer as the daemon."""
    candidates = ["/run/kb-kill/control.sock"]
    if base := os.environ.get("XDG_RUNTIME_DIR"):
        candidates.append(os.path.join(base, "kb-kill.sock"))
    found = next((c for c in candidates if os.path.exists(c)), None)
    if found:
        return found
    tmp = f"/tmp/kb-kill-{os.getuid()}.sock"
    try:
        st = os.lstat(tmp)
        if stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid():
            return tmp
    except OSError:
        pass
    return candidates[0]


def config_mtime() -> float | None:
    p = config_path()
    try:
        return p.stat().st_mtime if p else None
    except OSError:
        return None


def send(sock: socket.socket, obj: dict) -> None:
    sock.sendall((json.dumps(obj) + "\n").encode())


def push(sock: socket.socket) -> bool:
    """Send the config; True when it asks for the lock watch."""
    p = config_path()
    if p is None:
        log("no config file yet; will push when one appears")
        send(sock, {"cmd": "status"})  # completes the daemon's handshake
        return False
    text = p.read_text()
    send(sock, {"cmd": "set_config", "toml": text})
    log(f"pushed {p}")
    return wants_lock_watch(text)


def wants_lock_watch(text: str) -> bool:
    """Some group sets wake_on_lock. The daemon validates; this only looks."""
    try:
        groups = tomllib.loads(text).get("groups")
    except (tomllib.TOMLDecodeError, RecursionError):
        return False
    return isinstance(groups, dict) and any(
        isinstance(t, dict) and t.get("wake_on_lock") is True for t in groups.values()
    )


def _session_id(path: str) -> str:
    """logind's session id from its object path: '.../session/_32' -> '2'
    (sd-bus escapes each byte outside [A-Za-z0-9] as _XX)."""
    name = path.rpartition("/")[2]
    out, i = bytearray(), 0
    while i < len(name):
        if name[i] == "_" and i + 3 <= len(name):
            try:
                out.append(int(name[i + 1 : i + 3], 16))
                i += 3
                continue
            except ValueError:
                pass
        out += name[i].encode()
        i += 1
    return out.decode(errors="replace")


class LockWatch:
    """This user's screen locking and unlocking, from logind's signals via
    `gdbus monitor` and from COSMIC's lockfile."""

    def __init__(self) -> None:
        self.proc: subprocess.Popen | None = None
        self.session = ""  # our display session's object path
        self.lockfile: Path | None = None  # COSMIC's, while the screen is locked
        self.lockfile_seen = False
        self.gdbus = ""
        self.looked_at = 0.0  # last _find_session from a stranger's lock
        self.buf = b""
        self.retry_at = 0.0
        self._said_missing = False

    def fileno(self) -> int:
        assert self.proc is not None and self.proc.stdout is not None
        return self.proc.stdout.fileno()

    def want(self, on: bool) -> None:
        if not on:
            self.stop()
        elif self.proc is None and time.monotonic() >= self.retry_at:
            self.start()

    def start(self) -> None:
        gdbus = shutil.which("gdbus")
        if gdbus is None:
            if not self._said_missing:
                log(
                    "wake_on_lock needs gdbus (Debian/Ubuntu: libglib2.0-bin, Fedora/Arch: glib2)"
                )
                self._said_missing = True
            self.retry_at = time.monotonic() + LOCK_RETRY_SECONDS
            return
        self.gdbus = gdbus
        self._find_session()
        try:
            self.proc = subprocess.Popen(
                [gdbus, "monitor", "--system", "--dest", "org.freedesktop.login1"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
        except OSError as e:
            log(f"cannot watch for the screen lock: {e}")
            self.retry_at = time.monotonic() + LOCK_RETRY_SECONDS
            return
        self.buf = b""
        log(f"watching for the screen lock ({self.session or 'no display session'})")

    def _find_session(self) -> None:
        """Look up our display session. Again whenever logind adds or removes
        a session, or a lock comes from one we do not know: we may have
        started before the graphical login (lingering, SSH, a text console
        first), or the user logged out and in while we kept running."""
        try:
            # "auto" is the caller's session, or for a service outside one
            # (this one) the user's display session.
            out = subprocess.run(
                [
                    self.gdbus,
                    "call",
                    "--system",
                    "--dest",
                    "org.freedesktop.login1",
                    "--object-path",
                    LOGIN1,
                    "--method",
                    "org.freedesktop.login1.Manager.GetSession",
                    "auto",
                ],
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            ).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        # "(objectpath '/org/freedesktop/login1/session/_32',)"
        _, quote, rest = out.partition("'")
        session = rest.partition("'")[0] if quote else ""
        if session == self.session and self.proc is not None:
            return
        if self.proc is not None:  # not the first lookup
            log(f"display session now {session or 'none'}")
        self.session = session
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        sid = _session_id(session) if session else ""
        self.lockfile = (
            Path(runtime) / f"cosmic-greeter-{sid}.lock"
            if runtime and sid and "/" not in sid
            else None
        )
        # Already locked when we look: that lock was not seen, only its end is.
        self.lockfile_seen = self.lockfile is not None and self.lockfile.exists()

    def stop(self) -> None:
        if self.proc is not None:
            self.proc.kill()
            self.proc.wait()
            self.proc = None

    def read(self) -> list[str]:
        """Drain gdbus; the commands ("locked"/"unlocked") it reported, in order."""
        assert self.proc is not None and self.proc.stdout is not None
        chunk = os.read(self.fileno(), 65536)
        if not chunk:
            self.stop()
            self.retry_at = time.monotonic() + LOCK_RETRY_SECONDS
            return []
        *lines, self.buf = (self.buf + chunk).split(b"\n")
        self.buf = self.buf[-65536:]
        events = (self._event(line.decode(errors="replace")) for line in lines)
        return [e for e in events if e]

    def poll(self) -> list[str]:
        """COSMIC's lockfile appearing ("locked") or vanishing ("unlocked")."""
        if self.proc is None or self.lockfile is None:
            return []
        now = self.lockfile.exists()
        if now == self.lockfile_seen:
            return []
        self.lockfile_seen = now
        return ["locked" if now else "unlocked"]

    def _event(self, line: str) -> str | None:
        path, _, signal = line.partition(": ")
        if path == LOGIN1:
            if signal.startswith(
                (
                    "org.freedesktop.login1.Manager.SessionNew ",
                    "org.freedesktop.login1.Manager.SessionRemoved ",
                )
            ):
                self._find_session()
            return None
        if not path.startswith(LOGIN1 + "/session/"):
            return None
        cmd = _lock_cmd(signal)
        if cmd is None or path == self.session:
            return cmd
        now = time.monotonic()
        if now - self.looked_at < 1.0:
            return None  # another user's session; at most one look a second
        self.looked_at = now
        self._find_session()  # ours, now? (logind says nothing per user)
        return cmd if path == self.session else None


def _lock_cmd(signal: str) -> str | None:
    """A session's signal as the daemon command it means, if any."""
    if signal.startswith("org.freedesktop.login1.Session.Lock "):
        return "locked"
    if signal.startswith("org.freedesktop.login1.Session.Unlock "):
        return "unlocked"
    if signal.startswith("org.freedesktop.DBus.Properties.PropertiesChanged "):
        if "'LockedHint': <true>" in signal:
            return "locked"
        if "'LockedHint': <false>" in signal:
            return "unlocked"
    return None


def report_errors(buf: bytes) -> bytes:
    """Log the daemon's error replies (a rejected config) to this user's own
    journal; the daemon's journal is not theirs to read. State lines are
    ignored. Returns the unfinished line."""
    *lines, rest = buf.split(b"\n")
    for line in lines:
        try:
            msg = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if isinstance(msg, dict) and msg.get("type") == "error":
            log(f"daemon: {msg.get('error')}")
    return rest[-65536:]  # a line longer than the daemon ever sends: drop it


def serve_once(lock: LockWatch) -> None:
    """One connection: push, then re-push on each edit until the socket drops."""
    path = socket_path()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(path)
    except OSError:
        sock.close()
        return  # daemon not up yet; retry after RECONNECT_SECONDS
    try:
        log(f"connected to {path}")
        watch = push(sock)
        mtime = config_mtime()
        buf = b""
        while True:
            lock.want(watch)
            fds = [sock, lock] if lock.proc is not None else [sock]
            ready, _, _ = select.select(fds, [], [], POLL_SECONDS)
            if sock in ready:
                chunk = sock.recv(65536)
                if not chunk:
                    log("daemon closed the connection")
                    return
                buf = report_errors(buf + chunk)
            events = lock.read() if lock in ready else []
            for cmd in events + lock.poll():
                send(sock, {"cmd": cmd})
            if (now := config_mtime()) != mtime:
                mtime = now
                watch = push(sock)
    except OSError as e:
        log(f"connection lost: {e}")
    finally:
        sock.close()


def main() -> int:
    if sys.argv[1:] and sys.argv[1] in ("-V", "--version"):
        print(f"kb-kill-push {VERSION} ({Path(__file__).resolve()})")
        return 0
    log("starting; following this user's config")
    lock = LockWatch()
    try:
        while True:
            serve_once(lock)
            time.sleep(RECONNECT_SECONDS)
    finally:
        lock.stop()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
