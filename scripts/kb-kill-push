#!/usr/bin/env python3
"""kb-kill-push - hand the kb-kill daemon this user's config.

One instance per logged-in user. Reads the user's config file, pushes its text
over the daemon's control socket, re-pushes on every edit and reconnects if the
socket drops. The daemon binds the config to this process's uid (SO_PEERCRED)
and applies it only while this user controls the seat. Stdlib only.
"""

import json
import os
import socket
import stat
import sys
import time
from pathlib import Path

POLL_SECONDS = 1.0
RECONNECT_SECONDS = 2.0

# Rewritten by packaging/bump-version.sh from the repo-root VERSION file.
VERSION = "0.6.0"


def log(msg: str) -> None:
    sys.stderr.write(f"kb-kill-push: {msg}\n")
    sys.stderr.flush()


def config_path() -> Path | None:
    if env := os.environ.get("KB_KILL_CONFIG"):
        return Path(env).expanduser()
    for p in (
        Path.home() / ".config/kb-kill/kb-kill.toml",
        Path("/etc/kb-kill/kb-kill.toml"),
    ):
        if p.is_file():
            return p
    return None


def socket_path() -> str:
    """The daemon's socket. /run/kb-kill (made by systemd) and
    $XDG_RUNTIME_DIR (private to this user) are used as found. The /tmp
    fallback of a dev daemon only when this user owns it: anyone can create a
    file there, and would then read what is sent and answer as the daemon."""
    candidates = ["/run/kb-kill/control.sock"]
    if base := os.environ.get("XDG_RUNTIME_DIR"):
        candidates.append(os.path.join(base, "kb-kill.sock"))
    found = next((c for c in candidates if os.path.exists(c)), None)
    if found:
        return found
    tmp = f"/tmp/kb-kill-{os.getuid()}.sock"
    try:
        st = os.lstat(tmp)
        if stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid():
            return tmp
    except OSError:
        pass
    return candidates[0]


def config_mtime() -> float | None:
    p = config_path()
    try:
        return p.stat().st_mtime if p else None
    except OSError:
        return None


def send(sock: socket.socket, obj: dict) -> None:
    sock.sendall((json.dumps(obj) + "\n").encode())


def push(sock: socket.socket) -> None:
    p = config_path()
    if p is None:
        log("no config file yet; will push when one appears")
        send(sock, {"cmd": "status"})  # completes the daemon's handshake
        return
    send(sock, {"cmd": "set_config", "toml": p.read_text()})
    log(f"pushed {p}")


def report_errors(buf: bytes) -> bytes:
    """Log the daemon's error replies (a rejected config) to this user's own
    journal; the daemon's journal is not theirs to read. State lines are
    ignored. Returns the unfinished line."""
    *lines, rest = buf.split(b"\n")
    for line in lines:
        try:
            msg = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if isinstance(msg, dict) and msg.get("type") == "error":
            log(f"daemon: {msg.get('error')}")
    return rest[-65536:]  # a line longer than the daemon ever sends: drop it


def serve_once() -> None:
    """One connection: push, then re-push on each edit until the socket drops."""
    path = socket_path()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(path)
    except OSError:
        sock.close()
        return  # daemon not up yet; retry after RECONNECT_SECONDS
    try:
        log(f"connected to {path}")
        push(sock)
        mtime = config_mtime()
        sock.settimeout(POLL_SECONDS)
        buf = b""
        while True:
            try:
                chunk = sock.recv(65536)
                if not chunk:
                    log("daemon closed the connection")
                    return
                buf = report_errors(buf + chunk)
            except TimeoutError:
                pass
            if (now := config_mtime()) != mtime:
                mtime = now
                push(sock)
    except OSError as e:
        log(f"connection lost: {e}")
    finally:
        sock.close()


def main() -> int:
    if sys.argv[1:] and sys.argv[1] in ("-V", "--version"):
        print(f"kb-kill-push {VERSION} ({Path(__file__).resolve()})")
        return 0
    log("starting; following this user's config")
    while True:
        serve_once()
        time.sleep(RECONNECT_SECONDS)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
