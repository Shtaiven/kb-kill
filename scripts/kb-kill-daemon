#!/usr/bin/env python3
"""kb-kill-daemon - disable/enable target input devices on a global hotkey.

Runs as a long-lived root service. Any keyboard can press the configured *kill*
hotkey to disable (grab + eat all events from) the target device(s) - keyboards,
mice, or touchpads. While killed, every event from the target is swallowed
EXCEPT the *wake* hotkey, so a killed keyboard can always wake itself - there is
no way to lock yourself out. (A killed pointer self-wakes only if its wake combo
uses its own buttons, e.g. "mouseleft+mouseright"; otherwise wake it from the
keyboard.)

Config arrives by PUSH, not from a file path: the daemon starts config-less and
each logged-in user's `kb-kill-push` sends their config (TOML text) over the
control socket. The daemon honours only the config of the user who currently
controls a seat (logind's ACTIVE_UID, graphical or TTY), and switches when the
active user switches - so it always follows whoever is actually at the machine.
`-c PATH` pins a file config live for ad-hoc testing; detect/monitor read a file.

Design notes
------------
* "Disable" means EVIOCGRAB on the target device: the kernel routes its events
  exclusively to us and we drop them. We only grab *while killed* - when awake
  the target is merely monitored (read, never grabbed), so normal typing is
  100% native and a crash of this service cannot break the keyboard.
* We never re-inject events, so there is no virtual device and no awake-path
  latency.
* Coexistence with input-remapper: input-remapper grabs the physical keyboard
  (e.g. /dev/input/event3) and forwards it to a virtual "...forwarded" device.
  Mark such a group `virtual = true` and kb-kill targets only that virtual
  device, never the physical one, so input-remapper can always (re)grab the
  physical device - including across a restart. Ordinary groups (the default)
  grab matching devices directly. See `_resolve_targets`.
* Targets are chosen per group by name matchers, one per device class:
  `keyboards` (keyboard-class), `pointers` (mice/trackballs/touchpads), and
  `devices` (any class). Each entry matches case-insensitively as a substring
  OR an fnmatch glob (`*`/`?`/`[seq]`) of the whole name. A group needs at
  least one field; set several to kill, e.g., a keyboard and a mouse together.
  See `_dev_matches`.

Requires: python-evdev and read access to /dev/input/event*. The daemon runs as
root (the systemd service); `detect`/`monitor` therefore need `sudo`.
"""

import argparse
import ctypes
import errno
import fnmatch
import json
import os
import pwd
import re
import selectors
import signal
import socket
import struct
import sys
import time
import tomllib
from pathlib import Path

try:
    from evdev import (  # pyright: ignore[reportMissingImports]
        InputDevice,
        ecodes,
        list_devices,
    )
except ImportError:
    sys.stderr.write(
        "kb-kill: python-evdev is required. Install it from your distro's\n"
        "packages (pip is NOT the supported install method — the daemon runs as\n"
        "a root system service against the system interpreter):\n"
        "  Debian/Ubuntu : sudo apt install python3-evdev\n"
        "  Fedora        : sudo dnf install python3-evdev\n"
        "  Arch          : sudo pacman -S python-evdev\n"
    )
    sys.exit(1)


# Suite version. Source of truth is the VERSION file at the repo root; this
# constant is rewritten by packaging/bump-version.sh — don't edit it by hand.
VERSION = "0.3.0"


# --------------------------------------------------------------------------- #
# Modifier aliases
#
# A combo is written as `+`-joined tokens, e.g. "ctrl+alt+shift+k". Each token
# resolves to an "any-of" GROUP of acceptable keycodes; the combo matches when
# every group has at least one of its keycodes currently held.
#
# Bare modifier names match EITHER side; prefix with l/r to pin a side.
#
#   token                         matches (evdev KEY_*, code)
#   ----------------------------  -------------------------------------------
#   ctrl  / control               KEY_LEFTCTRL  (29)  or KEY_RIGHTCTRL  (97)
#   lctrl / rctrl                  left-only           / right-only
#   alt                           KEY_LEFTALT   (56)  or KEY_RIGHTALT  (100, AltGr)
#   lalt  / ralt                   left-only           / right-only
#   shift                         KEY_LEFTSHIFT (42)  or KEY_RIGHTSHIFT (54)
#   lshift / rshift                left-only           / right-only
#   super / meta / win / cmd      KEY_LEFTMETA  (125) or KEY_RIGHTMETA (126)
#   lsuper/lmeta / rsuper/rmeta    left-only           / right-only
#   mouseleft / mouseright        BTN_LEFT            / BTN_RIGHT
#   mousemiddle                   BTN_MIDDLE
#
# Any other token resolves to a single keycode: a letter a-z -> KEY_A..KEY_Z,
# a raw evdev name like KEY_SCROLLLOCK or BTN_SIDE (mouse buttons let a killed
# pointer self-wake), or a numeric keycode.
# --------------------------------------------------------------------------- #
MODIFIER_ALIASES = {
    "ctrl": frozenset({ecodes.KEY_LEFTCTRL, ecodes.KEY_RIGHTCTRL}),
    "control": frozenset({ecodes.KEY_LEFTCTRL, ecodes.KEY_RIGHTCTRL}),
    "lctrl": frozenset({ecodes.KEY_LEFTCTRL}),
    "rctrl": frozenset({ecodes.KEY_RIGHTCTRL}),
    "alt": frozenset({ecodes.KEY_LEFTALT, ecodes.KEY_RIGHTALT}),
    "lalt": frozenset({ecodes.KEY_LEFTALT}),
    "ralt": frozenset({ecodes.KEY_RIGHTALT}),
    "altgr": frozenset({ecodes.KEY_RIGHTALT}),
    "shift": frozenset({ecodes.KEY_LEFTSHIFT, ecodes.KEY_RIGHTSHIFT}),
    "lshift": frozenset({ecodes.KEY_LEFTSHIFT}),
    "rshift": frozenset({ecodes.KEY_RIGHTSHIFT}),
    "super": frozenset({ecodes.KEY_LEFTMETA, ecodes.KEY_RIGHTMETA}),
    "meta": frozenset({ecodes.KEY_LEFTMETA, ecodes.KEY_RIGHTMETA}),
    "win": frozenset({ecodes.KEY_LEFTMETA, ecodes.KEY_RIGHTMETA}),
    "cmd": frozenset({ecodes.KEY_LEFTMETA, ecodes.KEY_RIGHTMETA}),
    "lsuper": frozenset({ecodes.KEY_LEFTMETA}),
    "lmeta": frozenset({ecodes.KEY_LEFTMETA}),
    "rsuper": frozenset({ecodes.KEY_RIGHTMETA}),
    "rmeta": frozenset({ecodes.KEY_RIGHTMETA}),
    # Mouse-button aliases (for pointer self-wake, e.g. wake_combo =
    # "mouseleft+mouseright"). Raw BTN_* names also work via the fallback below.
    "mouseleft": frozenset({ecodes.BTN_LEFT}),
    "mouseright": frozenset({ecodes.BTN_RIGHT}),
    "mousemiddle": frozenset({ecodes.BTN_MIDDLE}),
}


def _invoking_home() -> Path:
    """Home directory of the user who invoked us, even under sudo/pkexec.

    A root `kb-kill detect`/`monitor` run via sudo gets HOME=/root, so a plain
    Path.home() would miss the user's config and force an explicit --config.
    Recover the real user from SUDO_USER (sudo) or PKEXEC_UID (polkit) and take
    their home from the passwd db; fall back to Path.home() when unprivileged or
    when there's no caller to recover (e.g. a bare systemd service, which passes
    --config anyway).
    """
    if os.geteuid() == 0:
        name = os.environ.get("SUDO_USER")
        if not name:
            uid = os.environ.get("PKEXEC_UID", "")
            if uid.isdigit():
                try:
                    name = pwd.getpwuid(int(uid)).pw_name
                except KeyError:
                    name = None
        if name and name != "root":
            try:
                return Path(pwd.getpwnam(name).pw_dir)
            except KeyError:
                pass
    return Path.home()


_HOME = _invoking_home()
CONFIG_SEARCH = [
    _HOME / ".config" / "kb-kill" / "kb-kill.toml",
    _HOME / ".kb-kill",
    Path("/etc/kb-kill/kb-kill.toml"),
]

# No built-in default hotkey on purpose: a keyboard can only ever be disabled by
# a combo the user explicitly set, so a fresh/empty config has no shortcut that
# can kill a keyboard. Combos are still inherited top-level -> [groups.*]; what's
# gone is a module-level fallback when nobody set one (that would be a hidden
# shortcut). A group with a target but no resolvable combo is a config error.

# How often (seconds) to rescan for hotplugged / recreated devices. Also the
# backstop interval for re-checking the active seat user (the inotify watch on
# the seats dir makes switches near-instant; this only covers a missed event).
RESCAN_INTERVAL = 2.0

# Control-socket DoS bounds. The socket is connectable by any local user (the
# SO_PEERCRED uid is the real gate), so the bounds are per-uid as well as global.
MAX_CLIENTS = 16  # concurrent control connections (global)
# Per-uid cap, so one user cannot starve the global pool. A single active user's
# NORMAL footprint is already 2 persistent connections (kb-kill-push + kb-kill-tray
# each hold one for their whole lifetime), so this must sit comfortably above 2:
# during a redeploy/login both restart, and the daemon still holds each dying
# client's connection until it reaps the EOF on its next loop iteration, so uid N
# can transiently need old-push + old-tray + new-push + new-tray = 4 at once. Set
# to 8 (push+tray, plus restart overlap, plus a stray/dev pusher) — still half the
# global pool. A cap of 2 here left zero headroom and wedged the reconnecting
# client in a refusal loop ("tray fails to connect" on install).
MAX_CONNS_PER_UID = 8
MAX_LINE = 65536  # bytes buffered per client before a newline; drop if exceeded
# (a full set_config TOML payload, JSON-escaped, must fit)
HANDSHAKE_SECONDS = 10  # drop a connection that sends no valid command in this long

# Group names and labels are echoed into the system log and the tray, so restrict
# them to a boring charset. TOML allows quoted keys with escapes, so
# [groups."x\nJul 27 00:00:00 host sshd[1]: Accepted password for root"] is a
# legal group name - without this, any local uid could forge journal records under
# kb-kill's identifier. (log() sanitizes too; this rejects at the door so the name
# shown in the tray and in error text is sane as well.) This is a charset check
# only - there is deliberately NO cap on how many groups a config may define.
GROUP_NAME_RE = re.compile(r"\A[A-Za-z0-9_][A-Za-z0-9 ._-]{0,31}\Z")
# A `label` is free display text ("Mouse & touchpad"), so it is only bounded and
# checked for control characters, not restricted to the name charset.
LABEL_MAX_LEN = 64

# logind exposes the foreground session's user per seat here, as ACTIVE_UID=.
# We read this file (systemd marks it "do not parse", so we parse defensively and
# tolerate any field being absent) rather than dlopen libsystemd for
# sd_seat_get_active(), which would risk tripping MemoryDenyWriteExecute.
SEATS_DIR = "/run/systemd/seats"

# inotify event masks (we only need "something in the seats dir changed").
_IN_MODIFY = 0x00000002
_IN_CLOSE_WRITE = 0x00000008
_IN_MOVED_TO = 0x00000080
_IN_CREATE = 0x00000100
_IN_DELETE = 0x00000200
_SEAT_MASK = _IN_MODIFY | _IN_CLOSE_WRITE | _IN_MOVED_TO | _IN_CREATE | _IN_DELETE

# Selector tag for the control socket's listening fd (devices use their path
# string as the tag; clients use ("client", conn); the seat inotify fd uses
# _SEATWATCH).
_LISTEN = object()
_SEATWATCH = object()


def control_socket_path() -> str:
    """Where the control socket lives.

    As the root system daemon it lives in /run/kb-kill (created by the unit's
    RuntimeDirectory=); when run unprivileged (e.g. for testing) it falls back to
    the user's runtime dir.
    """
    if os.geteuid() == 0:
        return "/run/kb-kill/control.sock"
    base = os.environ.get("XDG_RUNTIME_DIR")
    if base:
        return os.path.join(base, "kb-kill.sock")
    return f"/tmp/kb-kill-{os.getuid()}.sock"


# --------------------------------------------------------------------------- #
# Journal hygiene
# --------------------------------------------------------------------------- #
# Everything the SERVICE writes to stderr lands in the system journal, which on a
# stock Debian/Ubuntu/Pop!_OS desktop is readable by group `adm` (the primary user
# is in it) and is mirrored into /var/log/syslog (root:adm 0640) when journald
# forwards to syslog. Because `set_config` is accepted from ANY local uid by
# design, every log site is a channel an unprivileged, otherwise-sandboxed process
# can shape - push a config with one group per key, named after that key, and the
# daemon's own log becomes a keylogger. Three rules, enforced here rather than at
# 40-odd call sites:
#   1. Nothing that fires at per-key-event rate may reach the journal - even with
#      no key identity, the TIMING is a password side channel. Those lines go
#      through log_keys(), off unless KB_KILL_DEBUG_KEYS=1, and marked <7>/debug.
#   2. State/config/control lines go through a token bucket, so a hostile config
#      cannot turn KILLED/WOKEN into a per-keystroke record.
#   3. Attacker-supplied text (group names, labels, device names, parse errors) is
#      flattened to one printable, length-capped line: a TOML quoted key may
#      legally contain "\n", which would otherwise forge journal records.
LOG_MAX_LEN = 400
_LOG_UNSAFE = re.compile(r"[\x00-\x1f\x7f]")

# syslog priorities. systemd parses a leading "<N>" on stderr (SyslogLevelPrefix=yes
# is the default), which is what lets the unit's LogLevelMax= drop a whole class.
# Suppressed on a tty so `-c` dev runs and detect/monitor stay readable.
PRI_ERR, PRI_WARN, PRI_NOTICE, PRI_INFO, PRI_DEBUG = 3, 4, 5, 6, 7
try:
    _LOG_PREFIX = not sys.stderr.isatty()
except (AttributeError, ValueError):
    _LOG_PREFIX = True


def _safe(text: object) -> str:
    """One printable, length-capped line - no journal injection."""
    out = _LOG_UNSAFE.sub("?", str(text))
    return out if len(out) <= LOG_MAX_LEN else out[: LOG_MAX_LEN - 1] + "…"


def log(msg: str, pri: int = PRI_INFO) -> None:
    head = f"<{pri}>" if _LOG_PREFIX else ""
    sys.stderr.write(f"{head}kb-kill: {_safe(msg)}\n")
    sys.stderr.flush()


def log_warn(msg: str) -> None:
    log(msg, PRI_WARN)


# Per-key diagnostics (wake progress, deferred/failed grabs, grab/release). OFF
# unless the root operator opts in, because these fire at key-event rate and the
# journal is readable by group `adm`. THIS is the gate: with it unset the lines
# are never written at all, so there is nothing for journald to filter. The
# unit's LogLevelMax=info is only belt-and-braces against a future regression
# that emits a <7> line ungated - do not rely on it, since journald was measured
# NOT to apply LogLevelMax to stderr-derived priorities on every systemd version.
# Setting it is root-only either way (see README, "Turning on the per-key
# diagnostics").
DEBUG_KEYS = os.environ.get("KB_KILL_DEBUG_KEYS") == "1"


def log_keys(msg: str) -> None:
    """Key-event-rate diagnostics. Emits nothing unless DEBUG_KEYS is set."""
    if DEBUG_KEYS:
        log(msg, PRI_DEBUG)


# Token bucket for journal lines an attacker can trigger. The sustained rate is
# far too slow to carry typing - 12 wpm is ~1 key/100 ms, and 0.2 lines/s cannot
# encode that. There is deliberately no cap on group count, so this bucket is the
# sole bound on the KILLED/WOKEN channel; two consequences:
#   * It MUST stay global, never per-group, or N groups would leak a burst per
#     keystroke.
#   * The BURST is what an attacker gets for free, so keep it tight. A real toggle
#     costs one line, and the only legitimate way to spend several at once is
#     several groups sharing a combo, so 4 is already generous. Config/device
#     chatter has its own bucket (CTRL_LOG) and does not compete for these.
LOG_STATE_BURST = 4
LOG_STATE_REFILL = 0.2  # tokens/sec -> 1 line per 5 s sustained
LOG_SUPPRESS_NOTICE = 60.0  # at most one "N suppressed" summary per minute


class _RateLimiter:
    def __init__(self, burst: int, refill: float) -> None:
        self.burst: float = float(burst)
        self.refill: float = refill
        self.tokens: float = float(burst)
        self.last: float = time.monotonic()
        self.dropped: int = 0
        self.next_notice: float = 0.0

    def emit(self, msg: str, pri: int = PRI_INFO) -> None:
        now = time.monotonic()
        self.tokens = min(self.burst, self.tokens + (now - self.last) * self.refill)
        self.last = now
        if self.tokens >= 1.0:
            self.tokens -= 1.0
            log(msg, pri)
            return
        self.dropped += 1
        # Residual, disclosed channel: a COUNT at a fixed 60 s cadence. No
        # identity, no per-event timing.
        if now >= self.next_notice:
            self.next_notice = now + LOG_SUPPRESS_NOTICE
            n, self.dropped = self.dropped, 0
            log(f"suppressed {n} further log line(s) (rate limit)", PRI_NOTICE)


# Two buckets, so a config-push flood cannot starve legitimate KILLED/WOKEN lines.
STATE_LOG = _RateLimiter(LOG_STATE_BURST, LOG_STATE_REFILL)  # kill/wake
CTRL_LOG = _RateLimiter(8, 0.2)  # config pushes + control-socket refusals


def log_state(msg: str, pri: int = PRI_INFO) -> None:
    STATE_LOG.emit(msg, pri)


# --------------------------------------------------------------------------- #
# Active seat user (logind)
# --------------------------------------------------------------------------- #
def active_uids() -> set[int]:
    """Set of uids that own a *foreground* session, one per seat.

    Read from /run/systemd/seats/* (ACTIVE_UID=). This is how we decide whose
    pushed config governs the keyboard: only the user currently in control of a
    seat (graphical or TTY) is "live". Returns an empty set when logind exposes
    no seats (headless / container) - callers then fall back to idle.
    """
    uids = set()
    try:
        names = os.listdir(SEATS_DIR)
    except OSError:
        return uids
    for name in names:
        try:
            with open(os.path.join(SEATS_DIR, name)) as fh:
                for line in fh:
                    if line.startswith("ACTIVE_UID="):
                        val = line.strip().split("=", 1)[1]
                        if val.isdigit():
                            uids.add(int(val))
                        break
        except OSError:
            continue
    return uids


class SeatWatch:
    """inotify watch on the seats dir so active-user switches are near-instant.

    Pure-ctypes over libc (no extra shared object is dlopen'd, so this stays
    clear of MemoryDenyWriteExecute; inotify_init1/add_watch/read are all in the
    unit's @system-service syscall set). Best-effort: if inotify is unavailable
    the daemon still re-checks the active user every RESCAN_INTERVAL.
    """

    def __init__(self) -> None:
        self.fd = -1
        try:
            libc = ctypes.CDLL(None, use_errno=True)
            fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
            if fd < 0:
                raise OSError(ctypes.get_errno(), "inotify_init1")
            wd = libc.inotify_add_watch(fd, SEATS_DIR.encode(), _SEAT_MASK)
            if wd < 0:
                os.close(fd)
                raise OSError(ctypes.get_errno(), "inotify_add_watch")
            self.fd = fd
        except (OSError, AttributeError) as e:
            log_warn(
                f"seat inotify unavailable ({e}); polling active user every "
                f"{RESCAN_INTERVAL:g}s instead"
            )

    def drain(self) -> None:
        """Consume pending events; their content is irrelevant (we just re-read
        the seat files afterwards)."""
        if self.fd < 0:
            return
        try:
            while True:
                if not os.read(self.fd, 4096):
                    break
        except OSError:
            pass

    def close(self) -> None:
        if self.fd >= 0:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = -1


class ConfigError(Exception):
    pass


# --------------------------------------------------------------------------- #
# Config
# --------------------------------------------------------------------------- #
class Group:
    """One target set with its own kill/wake hotkeys."""

    def __init__(
        self,
        name: str,
        keyboards: list[str],
        pointers: list[str],
        devices: list[str],
        kill_combo: list[frozenset[int]],
        wake_combo: list[frozenset[int]],
        virtual: bool,
        kill_raw: str,
        wake_raw: str,
        label: str | None,
    ) -> None:
        self.name = name  # identity: logs, control commands, killed-state preserve
        self.label = label  # optional display name (config 'label'); tray shows it
        # Name matchers, one per device class (any may be empty). Each entry is
        # a lowercased substring-or-glob pattern:
        #   keyboards -> keyboard-class devices, pointers -> pointing devices,
        #   devices   -> any input device regardless of class. A device is a
        # target when it matches at least one applicable field. See _dev_matches.
        self.keyboards = keyboards  # lowercase patterns (keyboard-class only)
        self.pointers = pointers  # lowercase patterns (pointer-class only)
        self.devices = devices  # lowercase patterns (any class)
        self.kill_combo = kill_combo
        self.wake_combo = wake_combo
        # Grab only the input-remapper "forwarded" copy, never the physical
        # device (any class), so input-remapper can keep the physical one.
        self.virtual = virtual
        self.kill_raw = kill_raw  # original strings (for display)
        self.wake_raw = wake_raw
        # wake token names, aligned index-for-index with wake_combo (used by
        # the wake-progress debug log to name missing tokens)
        self.wake_tokens = [t.strip() for t in wake_raw.split("+") if t.strip()]
        # runtime state (managed by KbKill)
        self.targets: dict[str, InputDevice] = {}  # path -> InputDevice
        self.killed = False
        self.warned_empty = False  # zero-match warning emitted (reset on match)
        # Lockout advisories emitted once per config install, so a toggle loop
        # can't multiply journal lines. See _log_kill.
        self.warned_kill = False
        self.wake_progress: tuple[bool, ...] | None = None  # last logged (debug)


class Config:
    def __init__(self, groups: list[Group], source: str) -> None:
        self.groups = groups
        self.source = source  # where it came from (path or "uid N")


def _parse_token(token: str) -> frozenset[int]:
    """Resolve one combo token to a frozenset of acceptable keycodes."""
    t = token.strip().lower()
    if not t:
        raise ConfigError("empty key in combo")
    if t in MODIFIER_ALIASES:
        return MODIFIER_ALIASES[t]
    if len(t) == 1 and t.isalnum():
        name = f"KEY_{t.upper()}"
        code = getattr(ecodes, name, None)
        if code is not None:
            return frozenset({code})
    # raw evdev name, e.g. KEY_SCROLLLOCK / SCROLLLOCK / BTN_LEFT (mouse button)
    upper = t.upper()
    name = upper if upper.startswith(("KEY_", "BTN_")) else f"KEY_{upper}"
    code = getattr(ecodes, name, None)
    if code is not None:
        return frozenset({code})
    # numeric keycode
    if t.isdigit():
        return frozenset({int(t)})
    raise ConfigError(
        f"unknown key {token!r} (try ctrl/alt/shift/super, a-z, a KEY_*/BTN_* name, "
        "or mouseleft/mouseright/mousemiddle)"
    )


def _parse_combo(spec: str) -> list[frozenset[int]]:
    tokens = [tok for tok in spec.split("+") if tok.strip()]
    if not tokens:
        raise ConfigError(f"empty combo: {spec!r}")
    return [_parse_token(tok) for tok in tokens]


def find_config(explicit: str | None = None) -> Path:
    if explicit:
        p = Path(explicit).expanduser()
        if not p.is_file():
            raise ConfigError(f"config not found: {p}")
        return p
    env = os.environ.get("KB_KILL_CONFIG")
    if env:
        p = Path(env).expanduser()
        if not p.is_file():
            raise ConfigError(f"$KB_KILL_CONFIG points at a missing file: {p}")
        return p
    for p in CONFIG_SEARCH:
        # ~/.kb-kill may be a directory holding kb-kill.toml
        if p.is_dir():
            inner = p / "kb-kill.toml"
            if inner.is_file():
                return inner
        elif p.is_file():
            return p
    raise ConfigError(
        "no config file found. Create ~/.config/kb-kill/kb-kill.toml with:\n"
        '  keyboards  = "AT Translated Set 2 keyboard"   # or pointers = / devices =\n'
        '  kill_combo = "ctrl+alt+shift+k"\n'
        '  wake_combo = "ctrl+alt+shift+u"'
    )


# The device-matcher fields a group may set (at least one required).
_MATCH_KEYS = ("keyboards", "pointers", "devices")
# Keys allowed in a group table / the top-level default group. `virtual_keyboard`
# is the deprecated alias for `virtual` (kept for backward compatibility).
_GROUP_KEYS = {
    *_MATCH_KEYS,
    "label",
    "kill_combo",
    "wake_combo",
    "virtual",
    "virtual_keyboard",
}


def _as_names(value: object, where: str, field: str) -> list[str]:
    """Coerce a matcher field (string or list of strings) to a list of
    lowercased patterns (each matched as a substring or an fnmatch glob)."""
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        raise ConfigError(f"{where}: '{field}' must be a string or list of strings")
    names = [v.strip().lower() for v in value if v.strip()]
    if not names:
        raise ConfigError(f"{where}: '{field}' is empty")
    return names


def _build_group(name: str, table: dict, defaults: dict, where: str) -> Group:
    """Build a Group from a TOML table, inheriting unset combos from the
    top-level defaults. There is no built-in fallback: a group with a target
    keyboard but no kill_combo/wake_combo (here or inherited) is an error, so no
    keyboard can ever be disabled by a hotkey the user didn't explicitly set."""
    # Summarise past a handful: a pushed config is attacker-supplied, so a table
    # with thousands of stray keys must not become thousands of journal lines.
    unknown = [key for key in table if key not in _GROUP_KEYS]
    for key in unknown[:4]:
        CTRL_LOG.emit(f"warning: {where}: unknown key {key!r} (ignored)", PRI_WARN)
    if len(unknown) > 4:
        CTRL_LOG.emit(
            f"warning: {where}: {len(unknown) - 4} further unknown key(s) ignored",
            PRI_WARN,
        )

    # Each of keyboards/pointers/devices is optional, but at least one must be
    # present (a group with no matcher has nothing to grab).
    matchers = {
        field: _as_names(table[field], where, field)
        for field in _MATCH_KEYS
        if field in table
    }
    if not matchers:
        raise ConfigError(
            f"{where}: a group needs at least one of "
            f"{', '.join(_MATCH_KEYS)} (device-name matchers)."
        )
    kbs = matchers.get("keyboards", [])
    pointers = matchers.get("pointers", [])
    devs = matchers.get("devices", [])
    kill_raw = table.get("kill_combo", defaults["kill_combo"])
    wake_raw = table.get("wake_combo", defaults["wake_combo"])
    # `virtual` describes a target's nature, so it is per-group only (default
    # false) and never inherited from the top-level defaults. `virtual_keyboard`
    # is the deprecated alias (applied to all classes now, not just keyboards).
    if "virtual" in table and "virtual_keyboard" in table:
        raise ConfigError(
            f"{where}: set either 'virtual' or 'virtual_keyboard' (its deprecated "
            "alias), not both."
        )
    if "virtual_keyboard" in table:
        CTRL_LOG.emit(
            f"warning: {where}: 'virtual_keyboard' is deprecated — use 'virtual'",
            PRI_WARN,
        )
    virtual = table.get("virtual", table.get("virtual_keyboard", False))
    if not isinstance(virtual, bool):
        raise ConfigError(f"{where}: 'virtual' must be true or false")
    # Optional display label, shown by the tray instead of the group's table key.
    # Purely cosmetic: identity (control commands, killed-state preservation
    # across a re-push) stays the group name.
    label = table.get("label")
    if label is not None:
        if not isinstance(label, str) or not label.strip():
            raise ConfigError(f"{where}: 'label' must be a non-empty string")
        label = label.strip()
        # A label is free display text ("Mouse & touchpad"), so it gets a looser
        # rule than a group name: any printable string, bounded, but no control
        # characters — a TOML quoted value may contain "\n", and the label reaches
        # both the tray and (via a rejection message) the journal. See
        # GROUP_NAME_RE and the journal-hygiene note above log().
        if len(label) > LABEL_MAX_LEN or _LOG_UNSAFE.search(label):
            raise ConfigError(
                f"{where}: invalid 'label' {_safe(label)!r} — up to "
                f"{LABEL_MAX_LEN} printable characters, no control characters"
            )
    for combo_key, val in (("kill_combo", kill_raw), ("wake_combo", wake_raw)):
        if val is None:
            raise ConfigError(
                f"{where}: '{combo_key}' is required (no built-in default) — a "
                "keyboard can only be disabled by a combo you set explicitly."
            )
    if not isinstance(kill_raw, str) or not isinstance(wake_raw, str):
        raise ConfigError(f"{where}: 'kill_combo'/'wake_combo' must be strings")
    try:
        kill_combo = _parse_combo(kill_raw)
        wake_combo = _parse_combo(wake_raw)
    except ConfigError as e:
        raise ConfigError(f"{where}: {e}")
    return Group(
        name,
        kbs,
        pointers,
        devs,
        kill_combo,
        wake_combo,
        virtual,
        kill_raw,
        wake_raw,
        label,
    )


def parse_config(doc: dict, source: str) -> Config:
    """Build a Config from an already-parsed TOML document.

    Shared by load_config (a file, for detect/monitor and `-c` dev runs) and
    load_config_text (the TOML pushed over the control socket). Authorization is
    not carried in the config: the daemon binds each pushed config to the
    SO_PEERCRED uid that pushed it.
    """
    if not isinstance(doc, dict):
        raise ConfigError(f"{source}: top level must be a table")

    # Top-level keys form the default group (if they include a matcher field:
    # keyboards/pointers/devices) and supply defaults inherited by [groups.*].
    sections = doc.pop("groups", {})
    if not isinstance(sections, dict):
        raise ConfigError(f"{source}: 'groups' must be a table ([groups.<name>])")

    # No module-level fallback: an unset combo stays None and is inherited by
    # [groups.*]; if nothing sets it, _build_group rejects the group rather than
    # conjuring a hidden default hotkey.
    defaults = {
        "kill_combo": doc.get("kill_combo"),
        "wake_combo": doc.get("wake_combo"),
    }

    groups = []
    if any(field in doc for field in _MATCH_KEYS):
        groups.append(_build_group("default", doc, defaults, f"{source} [top-level]"))
    else:
        # No top-level group: validate stray top-level keys are known defaults.
        unknown = [key for key in doc if key not in _GROUP_KEYS]
        for key in unknown[:4]:
            CTRL_LOG.emit(
                f"warning: {source}: unknown top-level key {key!r} (ignored)", PRI_WARN
            )
        if len(unknown) > 4:
            CTRL_LOG.emit(
                f"warning: {source}: {len(unknown) - 4} further unknown top-level "
                "key(s) ignored",
                PRI_WARN,
            )

    for name, table in sections.items():
        if not GROUP_NAME_RE.match(name):
            raise ConfigError(
                f"{source}: invalid group name {_safe(name)!r} — up to 32 chars of "
                "letters, digits, space, '.', '_' or '-' (group names are echoed "
                "into the system log and the tray)"
            )
        if not isinstance(table, dict):
            raise ConfigError(f"{source}: [groups.{name}] must be a table")
        if not any(field in table for field in _MATCH_KEYS):
            raise ConfigError(
                f"{source}: [groups.{name}] needs one of "
                f"{', '.join(_MATCH_KEYS)} (device-name matchers)"
            )
        groups.append(_build_group(name, table, defaults, f"{source} [groups.{name}]"))

    if not groups:
        # An empty config is VALID and INERT: with no group there is no target
        # and no kill/wake combo, so the daemon only monitors and can never grab
        # a keyboard. This is the shipped default — a user must explicitly add a
        # group (top-level 'keyboards = ...' and/or a [groups.<name>] table)
        # before any hotkey can disable a keyboard.
        CTRL_LOG.emit(
            f"{source}: no groups defined — inert (monitor only, nothing can be killed)"
        )
    return Config(groups, source)


def load_config(explicit: str | None = None) -> Config:
    """Load a config from a file (detect/monitor and `-c` dev runs)."""
    path = find_config(explicit)
    try:
        with open(path, "rb") as fh:
            doc = tomllib.load(fh)
    except tomllib.TOMLDecodeError as e:
        raise ConfigError(f"{path}: invalid TOML: {e}")
    except OSError as e:
        raise ConfigError(f"{path}: {e}")
    return parse_config(doc, str(path))


def load_config_text(text: str, source: str) -> Config:
    """Load a config from TOML text pushed over the control socket."""
    try:
        doc = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        raise ConfigError(f"{source}: invalid TOML: {e}")
    except (TypeError, ValueError) as e:
        raise ConfigError(f"{source}: {e}")
    return parse_config(doc, source)


# --------------------------------------------------------------------------- #
# Device helpers
# --------------------------------------------------------------------------- #
def is_keyboard(dev: InputDevice) -> bool:
    """True for real typing keyboards (filters mice, power buttons, etc.)."""
    keys = dev.capabilities().get(ecodes.EV_KEY, [])
    return ecodes.KEY_A in keys and ecodes.KEY_Z in keys and ecodes.KEY_ENTER in keys


def is_pointer(dev: InputDevice) -> bool:
    """True for pointing devices: mice, trackballs, and touchpads.

    A pointer has a mouse button plus motion — relative (mice/trackballs) or
    an absolute touch surface (touchpads). This is the `pointers` field's class.
    """
    caps = dev.capabilities()
    keys = caps.get(ecodes.EV_KEY, [])
    has_button = ecodes.BTN_LEFT in keys or ecodes.BTN_MOUSE in keys
    rel = caps.get(ecodes.EV_REL, [])
    has_rel = ecodes.REL_X in rel and ecodes.REL_Y in rel
    has_abs_touch = ecodes.BTN_TOUCH in keys  # touchpads report an absolute surface
    return has_button and (has_rel or has_abs_touch)


def is_virtual(dev: InputDevice) -> bool:
    """True for uinput / forwarded devices (e.g. input-remapper output)."""
    phys = (dev.phys or "").lower()
    name = (dev.name or "").lower()
    return "uinput" in phys or "forwarded" in name or "input-remapper" in name


def grabbed_elsewhere(dev: InputDevice) -> bool:
    """True when another process holds an exclusive grab on `dev` (probed by
    attempting a grab: EBUSY means someone else has it). That process may be
    input-remapper (it grabs the physical device it fronts) or the kb-kill
    daemon itself while a group is killed. Skipped while keys are held so the
    momentary probe grab can't swallow a key-up and leave a key stuck down."""
    try:
        if dev.active_keys():
            return False
        dev.grab()
        dev.ungrab()
    except OSError as e:
        return e.errno == errno.EBUSY
    return False


def open_devices(want_pointers: bool = False) -> dict[str, InputDevice]:
    """Return {path: InputDevice} for every readable device we might target.

    Keyboards are always opened (so a killed pointer can be woken from the
    keyboard, and combos match globally). Pointers are only opened when the live
    config actually references them — keeping monitoring minimal for the common
    keyboard-only case.
    """
    found = {}
    for path in list_devices():
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        if is_keyboard(dev) or (want_pointers and is_pointer(dev)):
            found[path] = dev
        else:
            dev.close()
    return found


def combo_held(combo: list[frozenset[int]], pressed: set[int]) -> bool:
    """True when every token group has >=1 of its keycodes in `pressed`."""
    return all(group & pressed for group in combo)


# --------------------------------------------------------------------------- #
# Service
# --------------------------------------------------------------------------- #
class KbKill:
    def __init__(self, config: Config | None = None) -> None:
        self.sel = selectors.DefaultSelector()
        self.devices: dict[str, InputDevice] = {}  # path -> InputDevice (monitored)
        self.pressed: dict[str, set[int]] = {}  # path -> set[int]
        self.grabbed: set[str] = set()  # paths currently EVIOCGRAB'd by us
        self.running = True
        self.need_rescan = False

        # Dedup sets. _reconcile_grabs() runs on EVERY key event, so an
        # un-deduped log line inside it is a per-keystroke journal record naming
        # a device — see the journal-hygiene note above log().
        self._deferred: set[str] = set()  # paths whose grab is deferred (keys held)
        self._grab_failed: set[str] = set()  # paths whose last grab attempt failed
        self._read_errored: set[str] = set()  # paths that errored on read

        # Pure-push model: the daemon starts with no config and is told what to
        # do over the control socket. `pushed[uid]` holds the Config most
        # recently pushed by each uid; only the config of the uid that currently
        # controls a seat (active_uids()) is *live* and governs the keyboard.
        self.pushed: dict[int, Config] = {}  # uid -> Config (dropped on disconnect)
        self.live_uid: int | None = None  # uid whose config is governing, or None
        self.groups: list[Group] = []  # the live config's groups (empty when idle)

        # `-c PATH` dev mode: a file config forced live, bypassing seat
        # arbitration (so the daemon is usable for ad-hoc testing without a
        # pusher). Treated as if the invoking user pushed it and is always active.
        self.forced = config is not None
        if config is not None:
            self.pushed[os.getuid()] = config
            self.live_uid = os.getuid()
            self.groups = config.groups

        # control socket (now mandatory: it is how config arrives)
        self._listen: socket.socket | None = None
        self._sock_path: str | None = None
        # conn -> {"buf": bytes, "uid": int, "born": monotonic, "hello": bool}
        self.clients: dict[socket.socket, dict] = {}
        self._last_sig: tuple | None = None
        # seats inotify watch (best-effort; falls back to periodic polling)
        self._seatwatch: SeatWatch | None = None

    # -- device matching ----------------------------------------------------- #
    @staticmethod
    def _dev_matches(group: Group, dev: InputDevice) -> bool:
        """True if `dev` is a target of `group`.

        A device matches when its name matches an applicable matcher field:
        `keyboards` (keyboard-class only), `pointers` (pointer-class only), or
        `devices` (any class). Each entry matches as a case-insensitive substring
        or, additively, as a glob (fnmatch: `*`, `?`, `[seq]`) against the whole
        name — so a bare `*` matches every device.
        """
        low = (dev.name or "").lower()

        def hit(subs: list[str]) -> bool:
            return any(s in low or fnmatch.fnmatchcase(low, s) for s in subs)

        if hit(group.keyboards) and is_keyboard(dev):
            return True
        if hit(group.pointers) and is_pointer(dev):
            return True
        if hit(group.devices):
            return True
        return False

    def _resolve_targets(self, group: Group) -> dict[str, InputDevice]:
        """Pick the devices to grab for a group.

        For a `virtual` group (one fronted by an input-remapper "forwarded"
        device), target only the virtual device(s) and never the physical one,
        so input-remapper can always keep/regrab the physical device. For an
        ordinary group, grab whatever matches directly.
        """
        matched = {p: d for p, d in self.devices.items() if self._dev_matches(group, d)}
        if group.virtual:
            return {p: d for p, d in matched.items() if is_virtual(d)}
        return matched

    # -- device lifecycle ---------------------------------------------------- #
    def _add_device(self, path: str, dev: InputDevice) -> None:
        self.devices[path] = dev
        self.pressed[path] = set(dev.active_keys())
        self.sel.register(dev, selectors.EVENT_READ, path)

    def _remove_device(self, path: str) -> None:
        dev = self.devices.pop(path, None)
        if dev is not None:
            try:
                self.sel.unregister(dev)
            except (KeyError, ValueError):
                pass
            try:
                dev.close()
            except OSError:
                pass
        self.pressed.pop(path, None)
        for group in self.groups:
            group.targets.pop(path, None)
        self.grabbed.discard(path)
        # Clear the log-dedup state, so a device that comes back and genuinely
        # fails again is reported again.
        self._deferred.discard(path)
        self._grab_failed.discard(path)
        self._read_errored.discard(path)

    def rescan(self) -> None:
        self.need_rescan = False
        want_pointers = any(g.pointers or g.devices for g in self.groups)
        current = open_devices(want_pointers)

        # Drop devices that vanished.
        for path in list(self.devices):
            if path not in current:
                CTRL_LOG.emit(f"device gone: {path}")
                self._remove_device(path)

        # Add newly appeared devices.
        for path, dev in current.items():
            if path in self.devices:
                dev.close()  # already monitored; discard the duplicate handle
            else:
                self._add_device(path, dev)
                CTRL_LOG.emit(f"watching: {path} ({dev.name})")

        for group in self.groups:
            group.targets = self._resolve_targets(group)
        self._reconcile_grabs()
        self._warn_empty_groups()

    def _warn_empty_groups(self) -> None:
        """Warn once per group while it matches zero devices.

        A zero-match group is silent otherwise and looks exactly like a config
        that was never picked up (bad matcher, typo, or virtual=true filtering
        out every physical match). Runs after every rescan — i.e. right after a
        config push lands (pointer devices are only opened by that rescan, so
        checking earlier would false-positive) — and logs only on transitions:
        once when a group goes empty, once when a device appears for it.
        """
        for group in self.groups:
            if group.targets:
                if group.warned_empty:
                    group.warned_empty = False
                    CTRL_LOG.emit(
                        f"[{group.name}] now matches {len(group.targets)} device(s)"
                    )
                continue
            if group.warned_empty:
                continue
            group.warned_empty = True
            if group.virtual and any(
                self._dev_matches(group, d) for d in self.devices.values()
            ):
                CTRL_LOG.emit(
                    f"[{group.name}] warning: matches only physical devices and "
                    "virtual=true skips them — nothing will be grabbed (drop "
                    "'virtual' unless input-remapper fronts this device)",
                    PRI_WARN,
                )
            else:
                CTRL_LOG.emit(
                    f"[{group.name}] warning: matches no present device — "
                    "nothing will be grabbed until one appears (check the "
                    "matchers against `kb-kill-daemon detect`)",
                    PRI_WARN,
                )

    # -- live config (which pushed config governs the keyboard) -------------- #
    def _install_groups(self, groups: list[Group], preserve: dict[str, bool]) -> None:
        """Make `groups` the live set, releasing any prior grab first.

        We unconditionally ungrab everything before switching so a grab can never
        outlive the config that asked for it (the core no-lockout invariant). New
        groups start with killed taken from `preserve` (name -> killed), default
        False -- so a session switch (preserve={}) always lands AWAKE: a
        backgrounded user can never pre-arm a kill that fires on the incoming
        user or the login greeter. A re-push from the live uid passes its current
        killed map so a config edit doesn't surprise-enable/disable a keyboard.
        """
        for path in list(self.grabbed):
            self._ungrab(path)
        for g in groups:
            g.killed = preserve.get(g.name, False)
        self.groups = groups
        for g in self.groups:
            g.targets = self._resolve_targets(g)
        self._reconcile_grabs()
        # The new config may need pointer devices the previous one didn't (they
        # are only opened when a live group references them), so re-enumerate on
        # the next loop tick to pick them up promptly.
        self.need_rescan = True
        self._last_sig = None  # force a fresh state broadcast

    def _set_live(self, uid: int | None) -> None:
        """Switch which uid's pushed config governs the keyboard (starts awake)."""
        self.live_uid = uid
        cfg = self.pushed.get(uid) if uid is not None else None
        self._install_groups(cfg.groups if cfg else [], preserve={})
        if cfg:
            CTRL_LOG.emit(
                f"live config: uid {uid} -> {len(self.groups)} group(s) "
                f"[{', '.join(g.name for g in self.groups)}]"
            )
        else:
            CTRL_LOG.emit(
                "live config: none (idle) - no active user has pushed a config"
            )

    def _reevaluate_live(self) -> None:
        """Pick the live uid from the active seat user(s) and swap if it changed.

        Live uid = an active-seat uid that has pushed a config (deterministic by
        lowest uid when several seats are active). None -> idle. `-c` dev mode is
        pinned live and never re-evaluated.
        """
        if self.forced:
            return
        active = active_uids()
        desired = next((uid for uid in sorted(active) if uid in self.pushed), None)
        if desired != self.live_uid:
            self._set_live(desired)

    def _on_set_config(self, uid: int, text: str) -> None:
        """Handle a set_config push from `uid`: store it, apply if it's live."""
        try:
            cfg = load_config_text(text, f"uid {uid}")
        except ConfigError as e:
            CTRL_LOG.emit(f"rejected config from uid {uid}: {e}", PRI_WARN)
            return
        self.pushed[uid] = cfg
        if uid == self.live_uid:
            # The live user edited their config: re-apply, preserving killed state.
            preserve = {g.name: g.killed for g in self.groups}
            self._install_groups(cfg.groups, preserve)
            CTRL_LOG.emit(
                f"live config updated by uid {uid}: {len(self.groups)} group(s)"
            )
        else:
            # A (possibly newly-active) user pushed: maybe it should go live now.
            self._reevaluate_live()

    # -- grab / ungrab ------------------------------------------------------- #
    def _grab(self, path: str) -> None:
        dev = self.devices.get(path)
        if dev is None or path in self.grabbed:
            return
        try:
            dev.grab()
            self.grabbed.add(path)
            self._grab_failed.discard(path)
            # 1:1 with a kill, so its information is already in the KILLED line's
            # device count; keep the per-device detail for debug runs only.
            log_keys(f"grabbed (eating): {dev.name}")
        except OSError as e:
            # _reconcile_grabs runs on every key event and re-attempts a failed
            # grab each time, so an un-deduped failure here is a per-keystroke
            # journal line naming the device — and "busy" is the NORMAL state when
            # input-remapper holds the physical device. Log once per path.
            if path in self._grab_failed:
                return
            self._grab_failed.add(path)
            if e.errno == errno.EBUSY:
                log_warn(f"cannot grab {dev.name}: busy (held by another process)")
            else:
                log_warn(f"cannot grab {dev.name}: {e}")

    def _ungrab(self, path: str) -> None:
        dev = self.devices.get(path)
        if dev is not None and path in self.grabbed:
            try:
                dev.ungrab()
            except OSError:
                pass
            log_keys(f"released: {dev.name}")
        self.grabbed.discard(path)
        self._grab_failed.discard(path)

    # -- state transitions --------------------------------------------------- #
    def _global_pressed(self) -> set[int]:
        """Union of keys held across every monitored device.

        Combos are matched against this union, not a single device, because
        input-remapper fans one physical keyboard's keys out across several
        virtual devices (e.g. remapped keys on "input-remapper keyboard", the
        rest on the "...forwarded" device). Per-device matching would never see
        the whole combo. The trade-off - holding a modifier on one keyboard and
        a key on another would match - is harmless for hotkeys this size.
        """
        held = set()
        for keys in self.pressed.values():
            held |= keys
        return held

    def _reconcile_grabs(self) -> None:
        """Make the set of grabbed devices match the union of every killed
        group's targets.

        A device is grabbed once no matter how many killed groups want it, and
        stays grabbed while any of them is killed. Grabbing a device that
        currently has keys held would swallow their key-ups and leave them stuck
        down at the OS, so we defer grabbing such a device until it is idle
        (unless it is already grabbed). Each key-up re-runs this, which is what
        eventually grabs a deferred device once released.
        """
        desired = set()
        for group in self.groups:
            if group.killed:
                desired.update(group.targets)

        for path in desired:
            if path in self.grabbed:
                self._deferred.discard(path)
                continue
            if self.pressed.get(path):
                # Deduped AND debug-only: this fires on every key event while a
                # kill is pending and keys are held.
                if path not in self._deferred:
                    self._deferred.add(path)
                    log_keys(
                        f"deferring grab of {self.devices[path].name} "
                        "until keys released"
                    )
                continue
            self._deferred.discard(path)
            self._grab(path)

        for path in list(self.grabbed):
            if path not in desired:
                self._ungrab(path)

    def _toggle_groups(self, held: set[int]) -> None:
        """Flip each group's killed state when its kill/wake combo is held."""
        for group in self.groups:
            if not group.killed:
                if combo_held(group.kill_combo, held):
                    group.killed = True
                    self._log_kill(group)
            elif combo_held(group.wake_combo, held):
                group.killed = False
                log_state(f"[{group.name}] WOKEN")

    @staticmethod
    def _combo_satisfiable(combo: list[frozenset[int]], devs) -> bool:
        """True if `devs` can, between them, produce every token of `combo`."""
        caps: set[int] = set()
        for d in devs:
            caps |= set(d.capabilities().get(ecodes.EV_KEY, []))
        return all(token & caps for token in combo)

    def _log_kill(self, group: Group) -> None:
        # Lockout guard: warn (never refuse). A killed keyboard can always wake
        # itself (you type the wake combo on it). A killed pointer can only
        # self-wake if the wake combo is producible on the pointer (e.g. a
        # mouse-button combo); otherwise it must be woken from another device.
        #
        # The advisories are emitted at most once per group per config install, so
        # a toggle loop can't multiply them (warned_kill resets when
        # _install_groups rebuilds the Group objects).
        if not group.warned_kill:
            group.warned_kill = True
            non_targets = [p for p in self.devices if p not in group.targets]
            self_wakeable = self._combo_satisfiable(
                group.wake_combo, group.targets.values()
            )
            if not group.targets:
                log_state(
                    f"[{group.name}] kill: no target device present yet "
                    "(will grab when it appears)",
                    PRI_WARN,
                )
            elif not non_targets and not self_wakeable:
                log_state(
                    f"[{group.name}] warning: killing the only device(s) present and "
                    "the wake combo can't be produced on them — wake needs another "
                    "device, a config re-push, or a daemon restart",
                    PRI_WARN,
                )
            elif not non_targets:
                log_state(
                    f"[{group.name}] warning: killing the only device(s) present "
                    "(wake hotkey on them still works)",
                    PRI_WARN,
                )
            elif not self_wakeable:
                log_state(
                    f"[{group.name}] note: this group can't self-wake — use the wake "
                    "hotkey on another device (e.g. your keyboard)",
                    PRI_WARN,
                )
        # The device count carries what the (now debug-only) per-device "grabbed
        # (eating)" lines used to say, so a toggle costs exactly one journal record.
        log_state(f"[{group.name}] KILLED ({len(group.targets)} device(s))")

    # -- event handling ------------------------------------------------------ #
    def _process(self, path: str, event) -> None:
        if event.type != ecodes.EV_KEY:
            return
        pressed = self.pressed[path]
        if event.value == 1:  # key down
            pressed.add(event.code)
            self._toggle_groups(self._global_pressed())
        elif event.value == 0:  # key up
            pressed.discard(event.code)
        else:  # autorepeat (2) - ignore for combos
            return
        self._log_wake_progress(path)
        self._reconcile_grabs()

    def _log_wake_progress(self, path: str) -> None:
        """Debug aid for "wake doesn't fire": while a group is killed, log how
        much of its wake combo is currently held whenever that changes, plus
        which device delivered the deciding event.

        Security: this runs on EVERY key event, so it is not merely logged at a
        low level — with DEBUG_KEYS unset it is not written at all. It is NOT
        enough that the text holds no raw keycodes: the combo token names, the
        held counts and the source device name are each sufficient to rebuild
        what was typed when sampled at key rate, and the timing alone is a
        password side channel. Any local uid can push a config, so a group per
        key would otherwise make this a keylogger readable by group `adm`. See
        the journal-hygiene note above log().
        """
        if not DEBUG_KEYS:
            return
        held: set[int] | None = None
        for group in self.groups:
            if not group.killed:
                group.wake_progress = None
                continue
            if held is None:
                held = self._global_pressed()
            progress = tuple(bool(tok & held) for tok in group.wake_combo)
            if progress == group.wake_progress:
                continue
            group.wake_progress = progress
            missing = [t for t, ok in zip(group.wake_tokens, progress) if not ok]
            dev = self.devices.get(path)
            src = dev.name if dev is not None else path
            log_keys(
                f"[{group.name}] wake progress: {sum(progress)}/{len(progress)} "
                f"tokens held"
                + (f" (missing: {'+'.join(missing)})" if missing else "")
                + f" - last event from {src!r}"
            )

    def _read_device(self, dev: InputDevice, path: str) -> None:
        try:
            for event in dev.read():
                self._process(path, event)
            self._read_errored.discard(path)
        except OSError as e:
            if e.errno in (errno.ENODEV, errno.EBADF):
                log_warn(f"device removed mid-read: {path}")
                self._remove_device(path)
                self.need_rescan = True
            elif e.errno == errno.EAGAIN:
                self._read_errored.discard(path)  # healthy, just drained
            else:
                # A wedged fd stays readable, so this would otherwise spin the
                # event loop and flood the journal. Log once per path.
                if path not in self._read_errored:
                    self._read_errored.add(path)
                    log_warn(f"read error on {path}: {e}")

    # -- control socket (config push + tray) --------------------------------- #
    def _open_control_socket(self) -> None:
        """Open the control socket. MANDATORY now - it is how config arrives, so
        a failure to open is fatal (caller exits, systemd restarts us).

        The socket is connectable by any local user (mode 0666): a pusher must be
        able to bootstrap the daemon before any config (and therefore any allowed
        uid) exists. SO_PEERCRED is the real gate - see _accept_client /
        _apply_command - so this is not a weakening; it just moves the check from
        connect-time to per-command. No chown is needed (hence no CAP_CHOWN)."""
        path = control_socket_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path):
            os.unlink(path)
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.bind(path)
        os.chmod(path, 0o666)
        s.listen(MAX_CLIENTS)
        s.setblocking(False)
        self._listen = s
        self._sock_path = path
        self.sel.register(s, selectors.EVENT_READ, _LISTEN)
        log(
            f"control socket: {path} (any local user may connect; "
            "SO_PEERCRED gates every command)"
        )

    def _state_dict(self) -> dict:
        return {
            "type": "state",
            "groups": [
                {
                    "name": g.name,
                    "label": g.label or g.name,
                    "killed": g.killed,
                    "targets": len(g.targets),
                }
                for g in self.groups
            ],
        }

    def _send(self, conn: socket.socket, obj: dict) -> None:
        try:
            conn.sendall((json.dumps(obj) + "\n").encode())
        except OSError:
            self._drop_client(conn)

    def _peer_uid(self, conn: socket.socket) -> int | None:
        try:
            creds = conn.getsockopt(
                socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
            )
            _pid, uid, _gid = struct.unpack("3i", creds)
            return uid
        except OSError:
            return None

    def _accept_client(self) -> None:
        assert self._listen is not None  # registered in the selector => open
        try:
            conn, _ = self._listen.accept()
        except OSError:
            return
        uid = self._peer_uid(conn)
        if uid is None:
            conn.close()
            return
        # Per-uid cap so one user can't starve the global pool; then the global cap.
        if (
            uid != 0
            and sum(1 for c in self.clients.values() if c["uid"] == uid)
            >= MAX_CONNS_PER_UID
        ):
            CTRL_LOG.emit(
                f"control: per-uid connection cap reached for uid {uid}, refusing",
                PRI_WARN,
            )
            conn.close()
            return
        if len(self.clients) >= MAX_CLIENTS:
            CTRL_LOG.emit("control: client cap reached, refusing connection", PRI_WARN)
            conn.close()
            return
        conn.setblocking(False)
        self.clients[conn] = {
            "buf": b"",
            "uid": uid,
            "born": time.monotonic(),
            "hello": False,
        }
        self.sel.register(conn, selectors.EVENT_READ, ("client", conn))
        # Send current state only to someone allowed to see it (the live user/root).
        if uid in (0, self.live_uid):
            self._send(conn, self._state_dict())

    def _drop_client(self, conn: socket.socket) -> None:
        try:
            self.sel.unregister(conn)
        except (KeyError, ValueError):
            pass
        info = self.clients.pop(conn, None)
        try:
            conn.close()
        except OSError:
            pass
        # If the disconnecting client was a pushing user's only remaining
        # connection, drop their pushed config and revert (idle or next active).
        # In forced (-c) dev mode the config is pinned and never dropped.
        if info is not None and not self.forced:
            uid = info["uid"]
            if uid != 0 and not any(c["uid"] == uid for c in self.clients.values()):
                if self.pushed.pop(uid, None) is not None:
                    CTRL_LOG.emit(f"uid {uid} disconnected; dropping its pushed config")
                    if uid == self.live_uid:
                        self._reevaluate_live()

    def _sweep_handshake(self) -> None:
        """Drop connections that never sent a valid command in time (anti-DoS)."""
        now = time.monotonic()
        for conn, info in list(self.clients.items()):
            if not info["hello"] and (now - info["born"]) > HANDSHAKE_SECONDS:
                CTRL_LOG.emit(
                    f"control: dropping idle connection from uid {info['uid']} "
                    "(no command within handshake window)",
                    PRI_WARN,
                )
                self._drop_client(conn)

    def _read_client(self, conn: socket.socket) -> None:
        info = self.clients.get(conn)
        if info is None:
            return
        try:
            data = conn.recv(65536)
        except OSError:
            self._drop_client(conn)
            return
        if not data:
            self._drop_client(conn)
            return
        buf = info["buf"] + data
        *lines, rest = buf.split(b"\n")
        # DoS bound: drop a client that floods bytes without a newline.
        if len(rest) > MAX_LINE:
            CTRL_LOG.emit("control: dropping client (over-long line)", PRI_WARN)
            self._drop_client(conn)
            return
        info["buf"] = rest
        for line in lines:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if not isinstance(obj, dict):
                continue
            info["hello"] = True
            self._apply_command(obj, conn, info["uid"])

    def _apply_command(self, obj: dict, conn: socket.socket, uid: int) -> None:
        cmd = obj.get("cmd")

        # set_config: accepted from ANY uid, stored under that uid; it only
        # governs the keyboard while that uid is the active seat user.
        if cmd == "set_config":
            text = obj.get("toml")
            if isinstance(text, str):
                self._on_set_config(uid, text)
            return

        # status: only the live user (or root) may read live state.
        if cmd == "status":
            if uid in (0, self.live_uid):
                self._send(conn, self._state_dict())
            return

        # devices: dump what the daemon is monitoring/grabbing right now
        # (debug aid). Names, classes, and held-key COUNTS only — never
        # keycodes — so no key data crosses the socket.
        if cmd == "devices":
            if uid in (0, self.live_uid):
                self._send(
                    conn,
                    {
                        "type": "devices",
                        "devices": [
                            {
                                "path": p,
                                "name": d.name,
                                "class": "ptr" if is_pointer(d) else "kbd",
                                "virtual": is_virtual(d),
                                "grabbed": p in self.grabbed,
                                "held_keys": len(self.pressed.get(p, ())),
                            }
                            for p, d in sorted(self.devices.items())
                        ],
                    },
                )
            return

        # kill/wake/toggle: only the user whose config is currently live (or root).
        if uid not in (0, self.live_uid):
            CTRL_LOG.emit(
                f"control: rejected {cmd!r} from uid {uid} (not the live user)",
                PRI_WARN,
            )
            return
        group = next((g for g in self.groups if g.name == obj.get("group")), None)
        if group is None:
            return
        if cmd == "kill":
            group.killed = True
        elif cmd == "wake":
            group.killed = False
        elif cmd == "toggle":
            group.killed = not group.killed
        else:
            return
        log_state(
            f"[{group.name}] {'KILLED' if group.killed else 'WOKEN'} (via control)"
        )
        self._reconcile_grabs()

    def _maybe_broadcast(self) -> None:
        sig = tuple((g.killed, len(g.targets)) for g in self.groups)
        if sig == self._last_sig:
            return
        self._last_sig = sig
        state = self._state_dict()
        for conn, info in list(self.clients.items()):
            if info["uid"] in (0, self.live_uid):
                self._send(conn, state)

    # -- main loop ----------------------------------------------------------- #
    def run(self) -> int:
        def _stop(signum: int, frame: object) -> None:
            raise KeyboardInterrupt

        signal.signal(signal.SIGTERM, _stop)

        # Mandatory: without the socket the daemon can never receive a config.
        try:
            self._open_control_socket()
        except OSError as e:
            log(f"FATAL: cannot open control socket: {e}", PRI_ERR)
            return 1

        if self.forced:
            assert self.live_uid is not None  # forced => live_uid set in __init__
            log(f"forced config (-c): {self.pushed[self.live_uid].source}")
        else:
            log("waiting for a config push from the active user's kb-kill-push")

        # Watch the seats dir so active-user switches apply near-instantly; the
        # periodic rescan re-checks as a backstop if inotify is unavailable.
        self._seatwatch = SeatWatch()
        if self._seatwatch.fd >= 0:
            self.sel.register(self._seatwatch.fd, selectors.EVENT_READ, _SEATWATCH)

        self.rescan()
        self._reevaluate_live()
        # Seed the broadcast signature so newly-connected clients get state only
        # via the initial send, not a spurious startup broadcast.
        self._last_sig = tuple((g.killed, len(g.targets)) for g in self.groups)

        last_scan = time.monotonic()
        try:
            while self.running:
                events = self.sel.select(timeout=RESCAN_INTERVAL)
                for key, _ in events:
                    tag = key.data
                    if tag is _LISTEN:
                        self._accept_client()
                    elif tag is _SEATWATCH:
                        self._seatwatch.drain()
                        self._reevaluate_live()
                    elif isinstance(tag, tuple) and tag[0] == "client":
                        self._read_client(tag[1])
                    else:
                        assert isinstance(tag, str)  # a device fd: data is its path
                        self._read_device(key.fileobj, tag)
                now = time.monotonic()
                if self.need_rescan or (now - last_scan) >= RESCAN_INTERVAL:
                    self.rescan()
                    self._reevaluate_live()  # backstop for a missed inotify event
                    self._sweep_handshake()
                    last_scan = now
                self._maybe_broadcast()
        except KeyboardInterrupt:
            pass
        finally:
            self.cleanup()
        return 0

    def cleanup(self) -> None:
        for path in list(self.grabbed):
            self._ungrab(path)
        for path in list(self.devices):
            self._remove_device(path)
        for conn in list(self.clients):
            self._drop_client(conn)
        if self._seatwatch is not None:
            try:
                self.sel.unregister(self._seatwatch.fd)
            except (KeyError, ValueError):
                pass
            self._seatwatch.close()
        if self._listen is not None:
            try:
                self.sel.unregister(self._listen)
            except (KeyError, ValueError):
                pass
            try:
                self._listen.close()
            except OSError:
                pass
            if self._sock_path and os.path.exists(self._sock_path):
                try:
                    os.unlink(self._sock_path)
                except OSError:
                    pass
        log("stopped; keyboards restored")


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #
def cmd_run(config: Config | None) -> int:
    # config is None for the normal service (config arrives via push); a file
    # config from `-c` is pinned live for ad-hoc dev testing.
    return KbKill(config).run()


def cmd_detect(config: Config) -> int:
    print("=== kb-kill detect ===")
    print(f"session : {os.environ.get('XDG_SESSION_TYPE', 'unknown')}")
    print(f"config  : {config.source}")
    print()
    print("Groups:")
    if not config.groups:
        print("  (none) - config is INERT: kb-kill only monitors and can never")
        print("          disable a keyboard. Add a group (with kill/wake combos)")
        print("          to enable it; see the comments in kb-kill.toml.")
    for g in config.groups:
        matchers = ", ".join(
            f"{field}={getattr(g, field)}"
            for field in ("keyboards", "pointers", "devices")
            if getattr(g, field)
        )
        shown = f' (shown as "{g.label}")' if g.label else ""
        print(f"  [{g.name}]{shown}  {matchers}")
        print(f"  {'':9}kill={g.kill_raw}  wake={g.wake_raw}  virtual={g.virtual}")
    print()

    if os.geteuid() != 0:
        print("WARNING: not running as root - reading keyboards will fail.")
        print("  Re-run with sudo:  sudo kb-kill-daemon detect")
        print()

    devices = open_devices(want_pointers=True)
    if not devices:
        print("No input devices found (permission problem?).")
        return 1

    svc = KbKill(config)
    svc.devices = devices
    svc.pressed = {p: set() for p in devices}
    for g in config.groups:
        g.targets = svc._resolve_targets(g)

    print("Devices:")
    for path in sorted(devices):
        dev = devices[path]
        cls = "ptr" if is_pointer(dev) else "kbd"
        virt = "virtual " if is_virtual(dev) else "physical"
        target_of = [g.name for g in config.groups if path in g.targets]
        matched_of = [g.name for g in config.groups if svc._dev_matches(g, dev)]
        if target_of:
            mark = f"TARGET of {', '.join(target_of)} (grabbed when killed)"
        elif matched_of:
            mark = (
                f"matches {', '.join(matched_of)}, but skipped "
                "(virtual=true ignores the physical device)"
            )
        else:
            mark = "monitored only (can trigger any hotkey)"
        grab = (
            " [GRABBED by another process right now]" if grabbed_elsewhere(dev) else ""
        )
        print(f"  {path:24} [{cls}/{virt}] {dev.name}{grab}")
        print(f"  {'':24}   {mark}")

    empty = [g for g in config.groups if not g.targets]
    if empty:
        print()
        for g in empty:
            if g.virtual and any(svc._dev_matches(g, d) for d in devices.values()):
                print(
                    f"WARNING: [{g.name}] matches only physical devices and "
                    "virtual=true skips them —\n  nothing will be grabbed. Drop "
                    "'virtual' unless input-remapper fronts this device."
                )
            else:
                print(
                    f"WARNING: [{g.name}] matches no present device — nothing "
                    "will be grabbed until one appears."
                )
    for dev in devices.values():
        dev.close()
    return 0


def _keyname(code: int) -> str:
    name = ecodes.KEY.get(code, str(code))
    if isinstance(name, (list, tuple)):
        name = name[0]
    return name


def cmd_monitor(config: Config) -> int:
    """Print every key event with its device + keycode, and flag when the
    kill/wake combos match per-device or globally. Used to diagnose how
    input-remapper routes the target keyboard's keys."""
    devices = open_devices(want_pointers=True)
    if not devices:
        print("No input devices found.")
        return 1

    # An exclusive grab by another process routes a device's events away from
    # this monitor entirely — the #1 "my keys don't show up" confusion. Two
    # common grabbers: input-remapper (always grabs the physical device it
    # fronts) and the kb-kill daemon itself (grabs a group's targets while
    # that group is killed).
    hidden = [
        (path, dev.name) for path, dev in devices.items() if grabbed_elsewhere(dev)
    ]
    if hidden:
        print("NOTE: exclusively grabbed by another process (input-remapper, or")
        print("the kb-kill daemon while a group is killed) — events from these")
        print("devices will NOT appear below:")
        for path, name in sorted(hidden):
            print(f"  {path:20} {name}")
        print()

    sel = selectors.DefaultSelector()
    pressed: dict[str, set[int]] = {}
    for path, dev in devices.items():
        pressed[path] = set(dev.active_keys())
        sel.register(dev, selectors.EVENT_READ, path)

    print("Monitoring all input devices. Press a group's kill/wake combo.")
    for g in config.groups:
        print(f"  [{g.name}] kill={g.kill_raw} wake={g.wake_raw}")
    print("Ctrl+C to stop.\n")
    try:
        while True:
            for key, _ in sel.select():
                path = key.data
                dev = devices[path]  # InputDevice (key.fileobj is loosely typed)
                try:
                    events = list(dev.read())
                except OSError:
                    continue
                for ev in events:
                    if ev.type != ecodes.EV_KEY:
                        continue
                    p = pressed[path]
                    if ev.value == 1:
                        p.add(ev.code)
                    elif ev.value == 0:
                        p.discard(ev.code)
                    action = {1: "down", 0: "up", 2: "rept"}.get(ev.value, "?")
                    short = dev.name[:34]
                    glob = set().union(*pressed.values()) if pressed else set()
                    flags = []
                    for g in config.groups:
                        if combo_held(g.kill_combo, glob):
                            flags.append(f"KILL[{g.name}]")
                        if combo_held(g.wake_combo, glob):
                            flags.append(f"WAKE[{g.name}]")
                    tag = ("  <<< " + " ".join(flags)) if flags else ""
                    print(f"{path:20} {short:34} {_keyname(ev.code):16} {action}{tag}")
    except KeyboardInterrupt:
        pass
    finally:
        for dev in devices.values():
            dev.close()
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="kb-kill-daemon",
        description="Disable/enable target input devices (keyboards, mice, "
        "touchpads) on a global hotkey.",
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="run",
        choices=["run", "detect", "monitor"],
        help="run the service (default), detect input devices, "
        "or monitor raw key/button events for debugging",
    )
    parser.add_argument(
        "-c",
        "--config",
        help="path to a config file. detect/monitor read it to "
        "show your setup; for `run` it pins that config live "
        "for ad-hoc testing (the service instead receives "
        "config from the active user via kb-kill-push).",
    )
    # The path disambiguates a package install (/usr/bin) from an install.sh
    # deploy (/usr/local/bin) when both are present.
    parser.add_argument(
        "-V",
        "--version",
        action="version",
        version=f"kb-kill-daemon {VERSION} ({Path(__file__).resolve()})",
    )
    args = parser.parse_args(argv)

    # The service (`run` without -c) starts config-less and is fed by kb-kill-push.
    if args.command == "run" and not args.config:
        return cmd_run(None)

    try:
        config = load_config(args.config)
    except ConfigError as e:
        log(str(e), PRI_ERR)
        return 1

    if args.command == "detect":
        return cmd_detect(config)
    if args.command == "monitor":
        return cmd_monitor(config)
    return cmd_run(config)


if __name__ == "__main__":
    sys.exit(main())
