#!/usr/bin/env python3
"""kb-kill-daemon - disable/enable input devices on a global hotkey.

How it works
------------
* "Disable" is an exclusive EVIOCGRAB on each target device; its events are
  read here and dropped. A grab is held only while a group is killed. Awake,
  devices are only read, so a crash cannot break input, and the kernel releases
  every grab when the process exits. No virtual device, no re-injection.
* Config arrives over the control socket from each user's kb-kill-push. Only
  the config of the user who controls the seat (logind ACTIVE_UID) is live.
* A combo matches on the union of keys held across all monitored devices and
  fires on the rising edge only (per-group latch), so holding it cannot re-fire.
* Under `virtual = "auto"` a matched device that input-remapper fronts is
  swapped for its forwarded copy, leaving the hardware to the remapper.
* Needs read/write on /dev/input/event* (group `input`) and nothing else.
  The systemd unit runs it as a dynamic user with that supplementary group.

Development: `kb-kill-daemon -c FILE` pins a config live without a pusher.
Diagnostics: kb-kill-detect (what is matched) and kb-kill-monitor (raw events).
"""

import argparse
import ctypes
import errno
import fcntl
import fnmatch
import json
import math
import os
import re
import selectors
import signal
import socket
import struct
import sys
import time
import tomllib
from pathlib import Path

try:
    from evdev import (  # pyright: ignore[reportMissingImports]
        InputDevice,
        ecodes,
        list_devices,
    )
except ImportError:
    sys.stderr.write(
        "kb-kill: python-evdev is required (Debian/Ubuntu/Fedora: python3-evdev, "
        "Arch: python-evdev).\n"
    )
    sys.exit(1)

# Rewritten by packaging/bump-version.sh from the repo-root VERSION file.
VERSION = "0.4.1"

_CTRL = frozenset({ecodes.KEY_LEFTCTRL, ecodes.KEY_RIGHTCTRL})
_ALT = frozenset({ecodes.KEY_LEFTALT, ecodes.KEY_RIGHTALT})
_SHIFT = frozenset({ecodes.KEY_LEFTSHIFT, ecodes.KEY_RIGHTSHIFT})
_META = frozenset({ecodes.KEY_LEFTMETA, ecodes.KEY_RIGHTMETA})
MODIFIER_ALIASES: dict[str, frozenset[int]] = {
    "ctrl": _CTRL,
    "control": _CTRL,
    "lctrl": frozenset({ecodes.KEY_LEFTCTRL}),
    "rctrl": frozenset({ecodes.KEY_RIGHTCTRL}),
    "alt": _ALT,
    "lalt": frozenset({ecodes.KEY_LEFTALT}),
    "ralt": frozenset({ecodes.KEY_RIGHTALT}),
    "altgr": frozenset({ecodes.KEY_RIGHTALT}),
    "shift": _SHIFT,
    "lshift": frozenset({ecodes.KEY_LEFTSHIFT}),
    "rshift": frozenset({ecodes.KEY_RIGHTSHIFT}),
    "super": _META,
    "meta": _META,
    "win": _META,
    "cmd": _META,
    "lsuper": frozenset({ecodes.KEY_LEFTMETA}),
    "lmeta": frozenset({ecodes.KEY_LEFTMETA}),
    "rsuper": frozenset({ecodes.KEY_RIGHTMETA}),
    "rmeta": frozenset({ecodes.KEY_RIGHTMETA}),
    "mouseleft": frozenset({ecodes.BTN_LEFT}),
    "mouseright": frozenset({ecodes.BTN_RIGHT}),
    "mousemiddle": frozenset({ecodes.BTN_MIDDLE}),
}

RESCAN_INTERVAL = 10.0  # backstop only; inotify on /dev/input drives rescans
FRONTED_GRACE = 10.0  # leave fronted hardware alone this long after its copy vanishes
MAX_CLIENTS = 16
MAX_CONNS_PER_UID = 8  # push + tray, plus restart overlap
MAX_LINE = 65536  # bytes buffered per client before a newline
HANDSHAKE_SECONDS = 10  # drop a connection that never sends a command
GROUP_NAME_RE = re.compile(r"\A[A-Za-z0-9_][A-Za-z0-9 ._-]{0,31}\Z")
LABEL_MAX_LEN = 64
SEATS_DIR = "/run/systemd/seats"
INPUT_DIR = "/dev/input"

_IN_ATTRIB, _IN_CLOSE_WRITE, _IN_MOVED_TO, _IN_CREATE, _IN_DELETE = (
    0x4,
    0x8,
    0x80,
    0x100,
    0x200,
)
_SEAT_MASK = 0x2 | _IN_CLOSE_WRITE | _IN_MOVED_TO | _IN_CREATE | _IN_DELETE
_INPUT_MASK = _IN_ATTRIB | _IN_CREATE | _IN_DELETE | _IN_MOVED_TO
# EVIOCSMASK = _IOW('E', 0x93, struct input_mask{u32 type; u32 codes_size; u64 codes_ptr})
_EVIOCSMASK = 0x40104593
_MASKED_TYPES = (
    ecodes.EV_REL,
    ecodes.EV_ABS,
    ecodes.EV_MSC,
    ecodes.EV_SW,
    ecodes.EV_LED,
    ecodes.EV_SND,
    ecodes.EV_FF,
)

_LISTEN, _SEATWATCH, _INPUTWATCH = object(), object(), object()


def control_socket_path() -> str:
    runtime = os.environ.get("RUNTIME_DIRECTORY")  # set by systemd RuntimeDirectory=
    if runtime:
        return os.path.join(runtime.split(":")[0], "control.sock")
    base = os.environ.get("XDG_RUNTIME_DIR")
    if base:
        return os.path.join(base, "kb-kill.sock")
    return f"/tmp/kb-kill-{os.getuid()}.sock"


# --------------------------------------------------------------------------- #
# Logging. The journal is readable by group adm/wheel and any local uid can push
# a config, so: nothing at key-event rate, state lines through a global token
# bucket, and all text flattened to one printable line.
# --------------------------------------------------------------------------- #
LOG_MAX_LEN = 400
_LOG_UNSAFE = re.compile(r"[\x00-\x1f\x7f]")
PRI_ERR, PRI_WARN, PRI_NOTICE, PRI_INFO = 3, 4, 5, 6
try:
    _LOG_PREFIX = not sys.stderr.isatty()
except (AttributeError, ValueError):
    _LOG_PREFIX = True


def _safe(text: object) -> str:
    out = _LOG_UNSAFE.sub("?", str(text))
    return out if len(out) <= LOG_MAX_LEN else out[: LOG_MAX_LEN - 1] + "…"


def log(msg: str, pri: int = PRI_INFO) -> None:
    head = f"<{pri}>" if _LOG_PREFIX else ""
    sys.stderr.write(f"{head}kb-kill: {_safe(msg)}\n")
    sys.stderr.flush()


def log_warn(msg: str) -> None:
    log(msg, PRI_WARN)


class _RateLimiter:
    """Token bucket. Global on purpose: it is the only bound on the KILLED/AWAKE
    channel, and there is no cap on group count."""

    def __init__(self, burst: int, refill: float) -> None:
        self.burst = float(burst)
        self.refill = refill
        self.tokens = float(burst)
        self.last = time.monotonic()
        self.dropped = 0
        self.next_notice = 0.0

    def emit(self, msg: str, pri: int = PRI_INFO) -> None:
        now = time.monotonic()
        self.tokens = min(self.burst, self.tokens + (now - self.last) * self.refill)
        self.last = now
        if self.tokens >= 1.0:
            self.tokens -= 1.0
            log(msg, pri)
            return
        self.dropped += 1
        if now >= self.next_notice:
            self.next_notice = now + 60.0
            n, self.dropped = self.dropped, 0
            log(f"suppressed {n} further log line(s) (rate limit)", PRI_NOTICE)


STATE_LOG = _RateLimiter(4, 0.2)  # kill/wake transitions
CTRL_LOG = _RateLimiter(8, 0.2)  # config, devices, control-socket refusals


def log_state(msg: str, pri: int = PRI_INFO) -> None:
    STATE_LOG.emit(msg, pri)


# --------------------------------------------------------------------------- #
# logind seat + inotify
# --------------------------------------------------------------------------- #
def active_uids() -> set[int]:
    """uids owning a foreground session, one per seat (empty when headless)."""
    uids: set[int] = set()
    try:
        names = os.listdir(SEATS_DIR)
    except OSError:
        return uids
    for name in names:
        try:
            with open(os.path.join(SEATS_DIR, name)) as fh:
                for line in fh:
                    if line.startswith("ACTIVE_UID="):
                        val = line.strip().split("=", 1)[1]
                        if val.isdigit():
                            uids.add(int(val))
                        break
        except OSError:
            continue
    return uids


class InotifyWatch:
    """Non-blocking inotify fd on one directory (pure ctypes over libc; the
    stdlib has no inotify). fd is -1 when unavailable; callers then poll."""

    def __init__(self, path: str, mask: int) -> None:
        self.fd = -1
        try:
            libc = ctypes.CDLL(None, use_errno=True)
            fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
            if fd < 0:
                raise OSError(ctypes.get_errno(), "inotify_init1")
            if libc.inotify_add_watch(fd, path.encode(), mask) < 0:
                err = ctypes.get_errno()
                os.close(fd)
                raise OSError(err, "inotify_add_watch")
            self.fd = fd
        except (OSError, AttributeError) as e:
            log_warn(f"cannot watch {path} ({e}); polling every {RESCAN_INTERVAL:g}s")

    def drain(self) -> None:
        try:
            while self.fd >= 0 and os.read(self.fd, 4096):
                pass
        except OSError:
            pass

    def close(self) -> None:
        if self.fd >= 0:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = -1


# --------------------------------------------------------------------------- #
# Config
# --------------------------------------------------------------------------- #
class ConfigError(Exception):
    pass


VIRTUAL_LABELS: dict[bool | None, str] = {None: "auto", True: "true", False: "false"}


class Group:
    """A set of target devices with its own kill/wake combo."""

    def __init__(
        self,
        name: str,
        label: str | None,
        keyboards: list[str],
        pointers: list[str],
        devices: list[str],
        kill_raw: str,
        wake_raw: str,
        virtual: bool | None,
    ) -> None:
        self.name = name
        self.label = label
        self.keyboards = keyboards  # lowercased patterns per device class
        self.pointers = pointers
        self.devices = devices
        self.kill_raw = kill_raw
        self.wake_raw = wake_raw
        self.kill_combo = _parse_combo(kill_raw)
        self.wake_combo = _parse_combo(wake_raw)
        self.virtual = virtual  # None = "auto" (pair with a fronting remapper copy)
        # runtime
        self.targets: dict[str, InputDevice] = {}
        self.killed = False
        self.kill_held = False  # edge latches; see KbKill._toggle_groups
        self.wake_held = False

    @property
    def virtual_label(self) -> str:
        return VIRTUAL_LABELS[self.virtual]


class Config:
    def __init__(self, groups: list[Group], source: str) -> None:
        self.groups = groups
        self.source = source


def _parse_token(token: str) -> frozenset[int]:
    t = token.strip().lower()
    if not t:
        raise ConfigError("empty key in combo")
    if t in MODIFIER_ALIASES:
        return MODIFIER_ALIASES[t]
    upper = t.upper()
    for name in (f"KEY_{upper}", upper if upper.startswith(("KEY_", "BTN_")) else ""):
        code = getattr(ecodes, name, None) if name else None
        if code is not None:
            return frozenset({code})
    if t.isdigit():
        return frozenset({int(t)})
    raise ConfigError(
        f"unknown key {token!r} (try ctrl/alt/shift/super, a-z, a KEY_*/BTN_* name, "
        "or mouseleft/mouseright/mousemiddle)"
    )


def _parse_combo(spec: str) -> list[frozenset[int]]:
    tokens = [tok for tok in spec.split("+") if tok.strip()]
    if not tokens:
        raise ConfigError(f"empty combo: {spec!r}")
    return [_parse_token(tok) for tok in tokens]


_MATCH_KEYS = ("keyboards", "pointers", "devices")
_GROUP_KEYS = {
    *_MATCH_KEYS,
    "label",
    "kill_combo",
    "wake_combo",
    "virtual",
    "virtual_keyboard",
}
_GLOB_META_RE = re.compile(r"[*?]|\[[!^]?\]?[^]]*\]")
_NEG_CLASS_RE = re.compile(r"\[\^([^]]*\])")
MAX_PATTERNS_PER_ENTRY = 256  # brace expansion cap; configs come from any local uid


def _is_glob(pattern: str) -> bool:
    return _GLOB_META_RE.search(pattern) is not None


def _split_braces(pattern: str) -> list[str] | None:
    """Expand the first bash-style `{a,b}`; None when nothing is left to expand."""
    start = -1
    while True:
        start = pattern.find("{", start + 1)
        if start == -1:
            return None
        depth, parts, chunk = 0, [], start + 1
        for i in range(start, len(pattern)):
            c = pattern[i]
            if c == "{":
                depth += 1
            elif c == "}":
                depth -= 1
                if depth == 0:
                    if not parts:
                        break  # comma-less group is literal
                    parts.append(pattern[chunk:i])
                    return [pattern[:start] + p + pattern[i + 1 :] for p in parts]
            elif c == "," and depth == 1:
                parts.append(pattern[chunk:i])
                chunk = i + 1


def _expand_entry(pattern: str, where: str, field: str) -> list[str]:
    done: list[str] = []
    pending = [pattern]
    while pending:
        if len(done) + len(pending) > MAX_PATTERNS_PER_ENTRY:
            raise ConfigError(
                f"{where}: '{field}' entry expands to more than {MAX_PATTERNS_PER_ENTRY} patterns"
            )
        alternatives = _split_braces(pending[0])
        if alternatives is None:
            done.append(pending.pop(0))
        else:
            pending[:1] = alternatives
    return [_NEG_CLASS_RE.sub(r"[!\1", p) for p in done]


def _as_names(value: object, where: str, field: str) -> list[str]:
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        raise ConfigError(f"{where}: '{field}' must be a string or list of strings")
    names: list[str] = []
    for v in value:
        v = v.strip().lower()
        if v:
            names.extend(_expand_entry(v, where, field))
    names = list(dict.fromkeys(names))
    if not names:
        raise ConfigError(f"{where}: '{field}' is empty")
    return names


def _warn_unknown_keys(table: dict, where: str) -> None:
    unknown = [key for key in table if key not in _GROUP_KEYS]
    for key in unknown[:4]:
        CTRL_LOG.emit(f"warning: {where}: unknown key {key!r} (ignored)", PRI_WARN)
    if len(unknown) > 4:
        CTRL_LOG.emit(
            f"warning: {where}: {len(unknown) - 4} further unknown key(s) ignored",
            PRI_WARN,
        )


def _build_group(name: str, table: dict, defaults: dict, where: str) -> Group:
    _warn_unknown_keys(table, where)
    matchers = {f: _as_names(table[f], where, f) for f in _MATCH_KEYS if f in table}
    if not matchers:
        raise ConfigError(
            f"{where}: a group needs at least one of {', '.join(_MATCH_KEYS)}"
        )

    if "virtual" in table and "virtual_keyboard" in table:
        raise ConfigError(
            f"{where}: set 'virtual' or its deprecated alias 'virtual_keyboard', not both"
        )
    if "virtual_keyboard" in table:
        CTRL_LOG.emit(
            f"warning: {where}: 'virtual_keyboard' is deprecated, use 'virtual'",
            PRI_WARN,
        )
    virtual = table.get("virtual", table.get("virtual_keyboard", "auto"))
    if isinstance(virtual, str) and virtual.strip().lower() == "auto":
        virtual = None
    elif not isinstance(virtual, bool):  # bool check first: 1 == True
        raise ConfigError(f"{where}: 'virtual' must be true, false, or \"auto\"")

    label = table.get("label")
    if label is not None:
        if not isinstance(label, str) or not label.strip():
            raise ConfigError(f"{where}: 'label' must be a non-empty string")
        label = label.strip()
        if len(label) > LABEL_MAX_LEN or _LOG_UNSAFE.search(label):
            raise ConfigError(
                f"{where}: invalid 'label' {_safe(label)!r}: up to {LABEL_MAX_LEN} printable characters"
            )

    kill_raw = table.get("kill_combo", defaults["kill_combo"])
    wake_raw = table.get("wake_combo", defaults["wake_combo"])
    for key, val in (("kill_combo", kill_raw), ("wake_combo", wake_raw)):
        if val is None:
            raise ConfigError(
                f"{where}: '{key}' is required (there is no built-in hotkey)"
            )
        if not isinstance(val, str):
            raise ConfigError(f"{where}: '{key}' must be a string")
    try:
        return Group(
            name,
            label,
            matchers.get("keyboards", []),
            matchers.get("pointers", []),
            matchers.get("devices", []),
            kill_raw,
            wake_raw,
            virtual,
        )
    except ConfigError as e:
        raise ConfigError(f"{where}: {e}")


def parse_config(doc: object, source: str) -> Config:
    """Top-level keys form the "default" group (if they include a matcher) and
    supply combo defaults for every [groups.*] table."""
    if not isinstance(doc, dict):
        raise ConfigError(f"{source}: top level must be a table")
    sections = doc.pop("groups", {})
    if not isinstance(sections, dict):
        raise ConfigError(f"{source}: 'groups' must be a table ([groups.<name>])")
    defaults = {
        "kill_combo": doc.get("kill_combo"),
        "wake_combo": doc.get("wake_combo"),
    }

    groups = []
    if any(f in doc for f in _MATCH_KEYS):
        groups.append(_build_group("default", doc, defaults, f"{source} [top-level]"))
    else:
        _warn_unknown_keys(doc, source)
    for name, table in sections.items():
        if not GROUP_NAME_RE.match(name):
            raise ConfigError(
                f"{source}: invalid group name {_safe(name)!r}: up to 32 letters, digits, "
                "space, '.', '_' or '-'"
            )
        if not isinstance(table, dict):
            raise ConfigError(f"{source}: [groups.{name}] must be a table")
        groups.append(_build_group(name, table, defaults, f"{source} [groups.{name}]"))
    if not groups:
        CTRL_LOG.emit(f"{source}: no groups defined; inert (monitor only)")
    return Config(groups, source)


def load_config_file(path: str) -> Config:
    p = Path(path).expanduser()
    try:
        with open(p, "rb") as fh:
            return parse_config(tomllib.load(fh), str(p))
    except tomllib.TOMLDecodeError as e:
        raise ConfigError(f"{p}: invalid TOML: {e}")
    except OSError as e:
        raise ConfigError(f"{p}: {e}")


def load_config_text(text: str, source: str) -> Config:
    try:
        return parse_config(tomllib.loads(text), source)
    except (tomllib.TOMLDecodeError, TypeError, ValueError) as e:
        raise ConfigError(f"{source}: {e}")


# --------------------------------------------------------------------------- #
# Devices
# --------------------------------------------------------------------------- #
def is_keyboard(dev: InputDevice) -> bool:
    keys = dev.capabilities().get(ecodes.EV_KEY, [])
    return ecodes.KEY_A in keys and ecodes.KEY_Z in keys and ecodes.KEY_ENTER in keys


def is_pointer(dev: InputDevice) -> bool:
    """A mouse button plus relative motion (mouse) or a touch surface (touchpad)."""
    caps = dev.capabilities()
    keys = caps.get(ecodes.EV_KEY, [])
    rel = caps.get(ecodes.EV_REL, [])
    has_button = ecodes.BTN_LEFT in keys or ecodes.BTN_MOUSE in keys
    has_motion = (
        ecodes.REL_X in rel and ecodes.REL_Y in rel
    ) or ecodes.BTN_TOUCH in keys
    return has_button and has_motion


def is_virtual(dev: InputDevice) -> bool:
    """uinput / remapper output. input-remapper <= 2.2.0 marked the name,
    >= 2.2.1 marks phys as "input-remapper/<orig phys>"."""
    phys = (dev.phys or "").lower()
    name = (dev.name or "").lower()
    return (
        "uinput" in phys
        or "input-remapper" in phys
        or "forwarded" in name
        or "input-remapper" in name
    )


def device_class(dev: InputDevice) -> str:
    return "kbd" if is_keyboard(dev) else "ptr" if is_pointer(dev) else "other"


def fronting_map(devices: dict[str, InputDevice]) -> dict[str, tuple[str, InputDevice]]:
    """physical path -> (path, dev) of the input-remapper copy that fronts it.
    Pairs by phys ("input-remapper/<phys>", 2.2.1+) or by the older name
    ("input-remapper <name> forwarded"). Strictly per device."""
    by_phys: dict[str, tuple[str, InputDevice]] = {}
    by_name: dict[str, tuple[str, InputDevice]] = {}
    for path, dev in devices.items():
        phys = (dev.phys or "").lower()
        name = (dev.name or "").lower()
        if phys.startswith("input-remapper/") and len(phys) > len("input-remapper/"):
            by_phys[phys[len("input-remapper/") :]] = (path, dev)
        if name.startswith("input-remapper ") and name.endswith(" forwarded"):
            fronted = name[len("input-remapper ") : -len(" forwarded")]
            if fronted:
                by_name[fronted] = (path, dev)
    out: dict[str, tuple[str, InputDevice]] = {}
    for path, dev in devices.items():
        if is_virtual(dev):
            continue
        front = by_phys.get((dev.phys or "").lower()) or by_name.get(
            (dev.name or "").lower()
        )
        if front is not None:
            out[path] = front
    return out


def active_keys_safe(dev: InputDevice) -> set[int] | None:
    """Keys the kernel reports held, or None if the device is gone (python-evdev
    raises SystemError, not OSError, when the ioctl fails on an unplugged node).
    None means "unknown", never "nothing held"."""
    try:
        return set(dev.active_keys())
    except (OSError, SystemError):
        return None


def mask_to_keys(fd: int) -> None:
    """Ask the kernel to deliver only EV_KEY (and EV_SYN) on this fd. Motion
    never reaches the process and cannot overflow the client buffer."""
    for ev_type in _MASKED_TYPES:
        try:
            fcntl.ioctl(fd, _EVIOCSMASK, struct.pack("IIQ", ev_type, 0, 0))
        except OSError:
            return  # old kernel: fall back to filtering in _process


def combo_held(combo: list[frozenset[int]], pressed: set[int]) -> bool:
    return all(group & pressed for group in combo)


# --------------------------------------------------------------------------- #
# Daemon
# --------------------------------------------------------------------------- #
class KbKill:
    def __init__(self, config: Config | None = None) -> None:
        self.sel = selectors.DefaultSelector()
        self.devices: dict[str, InputDevice] = {}  # path -> monitored device
        self.pressed: dict[str, set[int]] = {}  # path -> keys currently held
        self.grabbed: set[str] = set()
        self.running = True
        self.need_rescan = False
        self.pushed: dict[int, Config] = {}  # uid -> most recent config
        self.live_uid: int | None = None
        self.groups: list[Group] = []
        self.forced = config is not None  # -c: pinned live, no arbitration
        if config is not None:
            self.pushed[os.getuid()] = config
            self.live_uid = os.getuid()
            self.groups = config.groups
        self.clients: dict[
            socket.socket, dict
        ] = {}  # conn -> {buf, uid, born, hello, debug}
        self._listen: socket.socket | None = None
        self._sock_path: str | None = None
        self._watches: list[InotifyWatch] = []
        self._last_sig: tuple | None = None
        self._said: set[str] = set()  # keys of one-shot log lines already emitted
        self._fronting: dict[str, tuple[str, InputDevice]] = {}
        self._fronted_until: dict[
            str, float
        ] = {}  # physical path -> inf while fronted, else grace deadline

    # -- one-shot / debug logging ------------------------------------------- #
    def _once(self, key: str, msg: str, pri: int = PRI_INFO) -> None:
        if key not in self._said:
            self._said.add(key)
            CTRL_LOG.emit(msg, pri)

    def _forget(self, *keys: str) -> None:
        self._said.difference_update(keys)

    def _debug(self, msg: str) -> None:
        """Key-rate diagnostics, sent only to root clients that subscribed."""
        for conn, info in list(self.clients.items()):
            if info["debug"]:
                self._send(conn, {"type": "debug", "msg": _safe(msg)})

    # -- matching ------------------------------------------------------------- #
    @staticmethod
    def _dev_matches(group: Group, dev: InputDevice) -> bool:
        low = (dev.name or "").lower()

        def hit(patterns: list[str]) -> bool:
            return any(
                fnmatch.fnmatchcase(low, p) if _is_glob(p) else low == p
                for p in patterns
            )

        return (
            (hit(group.keyboards) and is_keyboard(dev))
            or (hit(group.pointers) and is_pointer(dev))
            or hit(group.devices)
        )

    def _update_fronting(self) -> None:
        """Recompute remapper pairs. A physical device whose copy just vanished
        stays off-limits for FRONTED_GRACE so a restarting remapper can re-grab
        it; grabbing it ourselves would make the remapper give up on it."""
        now = time.monotonic()
        self._fronting = fronting_map(self.devices)
        for path in self._fronting:
            self._fronted_until[path] = math.inf
        for path, until in list(self._fronted_until.items()):
            if path in self._fronting:
                continue
            if until == math.inf:
                self._fronted_until[path] = now + FRONTED_GRACE
                dev = self.devices.get(path)
                if dev is not None:
                    CTRL_LOG.emit(
                        f"{dev.name}: remapper copy vanished; leaving it alone for {FRONTED_GRACE:g}s"
                    )
            elif until <= now:
                del self._fronted_until[path]

    def _resolve_targets(self, group: Group) -> dict[str, InputDevice]:
        now = time.monotonic()
        out: dict[str, InputDevice] = {}
        for path, dev in self.devices.items():
            if not self._dev_matches(group, dev):
                continue
            if group.virtual is False:
                out[path] = dev
            elif (front := self._fronting.get(path)) is not None:
                out[front[0]] = front[1]  # the remapper's copy instead of the hardware
            elif self._fronted_until.get(path, 0.0) <= now:
                out[path] = dev
        if group.virtual is True:
            out = {p: d for p, d in out.items() if is_virtual(d)}
        return out

    # -- device lifecycle ----------------------------------------------------- #
    def _wanted(self, dev: InputDevice) -> bool:
        want_pointers = any(g.pointers or g.devices for g in self.groups)
        return is_keyboard(dev) or (want_pointers and is_pointer(dev))

    def _add_device(self, path: str) -> None:
        try:
            dev = InputDevice(path)
        except OSError:
            return  # not (yet) readable; the next inotify event retries
        held = active_keys_safe(dev) if self._wanted(dev) else None
        if held is None:
            dev.close()
            return
        mask_to_keys(dev.fd)
        self.devices[path] = dev
        self.pressed[path] = held
        self.sel.register(dev, selectors.EVENT_READ, path)
        CTRL_LOG.emit(f"watching: {path} ({dev.name})")

    def _remove_device(self, path: str) -> None:
        dev = self.devices.pop(path, None)
        if dev is None:
            return
        try:
            self.sel.unregister(dev)
        except (KeyError, ValueError):
            pass
        try:
            dev.close()
        except OSError:
            pass
        self.pressed.pop(path, None)
        self.grabbed.discard(path)
        self._fronted_until.pop(path, None)
        for g in self.groups:
            g.targets.pop(path, None)
        self._forget(f"grab:{path}", f"read:{path}", f"defer:{path}")

    @staticmethod
    def _stale(path: str, dev: InputDevice) -> bool:
        """True when the node was re-created since we opened it (same path,
        new inode), as input-remapper does on every preset apply."""
        try:
            return os.stat(path).st_ino != os.fstat(dev.fd).st_ino
        except OSError:
            return True

    def rescan(self) -> None:
        self.need_rescan = False
        present = set(list_devices())
        for path, dev in list(self.devices.items()):
            if path not in present or self._stale(path, dev) or not self._wanted(dev):
                CTRL_LOG.emit(f"dropped: {path} ({dev.name})")
                self._remove_device(path)
        for path in sorted(present - self.devices.keys()):
            self._add_device(path)
        self._update_fronting()
        for g in self.groups:
            g.targets = self._resolve_targets(g)
        self._release_stale_keys()
        self._reconcile_grabs()
        self._warn_groups()
        self._maybe_broadcast()

    def _release_stale_keys(self) -> None:
        """Intersect `pressed` with the kernel's view. Drop-only, so it can only
        re-arm a combo, never complete one: a device another process has grabbed
        delivers us nothing, and a key held at that moment would stay "held"."""
        for path, dev in self.devices.items():
            held = self.pressed[path]
            if held:
                live = active_keys_safe(dev)
                if live is not None:
                    held &= live
        self._sync_latches(self._global_pressed())

    def _warn_groups(self) -> None:
        for g in self.groups:
            if g.virtual is False and any(p in self._fronting for p in g.targets):
                self._once(
                    f"fights:{g.name}",
                    f"[{g.name}] warning: virtual=false targets hardware a remapper fronts; the grab will fight it",
                    PRI_WARN,
                )
            if g.targets:
                if f"empty:{g.name}" in self._said:
                    self._forget(f"empty:{g.name}")
                    CTRL_LOG.emit(f"[{g.name}] now matches {len(g.targets)} device(s)")
                continue
            if g.virtual is True and any(
                self._dev_matches(g, d) for d in self.devices.values()
            ):
                why = "virtual=true skips the physical devices it matches"
            else:
                why = "check names with kb-kill-detect; an entry without a wildcard must equal the whole name"
            self._once(
                f"empty:{g.name}",
                f"[{g.name}] warning: matches no device, nothing will be grabbed ({why})",
                PRI_WARN,
            )

    # -- live config ---------------------------------------------------------- #
    def _install_groups(self, groups: list[Group], preserve: dict[str, bool]) -> None:
        """Make `groups` live. Ungrabs everything first (a grab never outlives its
        config); killed state comes from `preserve`, so a user switch (empty map)
        always starts awake."""
        for path in list(self.grabbed):
            self._ungrab(path)
        for g in groups:
            g.killed = preserve.get(g.name, False)
        self.groups = groups
        self._said = {
            k
            for k in self._said
            if k.split(":", 1)[0] not in ("empty", "fights", "selfwake", "notarget")
        }
        self._sync_latches(self._global_pressed())
        self.rescan()

    def _set_live(self, uid: int | None) -> None:
        self.live_uid = uid
        cfg = self.pushed.get(uid) if uid is not None else None
        self._install_groups(cfg.groups if cfg else [], preserve={})
        if cfg:
            CTRL_LOG.emit(
                f"live config: uid {uid} -> {len(self.groups)} group(s) [{', '.join(g.name for g in self.groups)}]"
            )
        else:
            CTRL_LOG.emit(
                "live config: none (idle); no active user has pushed a config"
            )

    def _reevaluate_live(self) -> None:
        if self.forced:
            return
        desired = next(
            (uid for uid in sorted(active_uids()) if uid in self.pushed), None
        )
        if desired != self.live_uid:
            self._set_live(desired)

    def _on_set_config(self, uid: int, text: str) -> None:
        try:
            cfg = load_config_text(text, f"uid {uid}")
        except ConfigError as e:
            CTRL_LOG.emit(f"rejected config from uid {uid}: {e}", PRI_WARN)
            return
        self.pushed[uid] = cfg
        if uid == self.live_uid:
            self._install_groups(cfg.groups, {g.name: g.killed for g in self.groups})
            CTRL_LOG.emit(
                f"live config updated by uid {uid}: {len(self.groups)} group(s)"
            )
        else:
            self._reevaluate_live()

    # -- grabs ---------------------------------------------------------------- #
    def _grab(self, path: str) -> bool:
        dev = self.devices.get(path)
        if dev is None or path in self.grabbed:
            return False
        try:
            dev.grab()
        except OSError as e:
            why = "busy (held by another process)" if e.errno == errno.EBUSY else str(e)
            self._once(f"grab:{path}", f"cannot grab {dev.name}: {why}", PRI_WARN)
            return False
        self.grabbed.add(path)
        self._forget(f"grab:{path}", f"defer:{path}")
        self._debug(f"grabbed: {dev.name}")
        return True

    def _ungrab(self, path: str) -> bool:
        dev = self.devices.get(path)
        released = False
        if dev is not None and path in self.grabbed:
            try:
                dev.ungrab()
            except OSError:
                pass
            self._debug(f"released: {dev.name}")
            released = True
        self.grabbed.discard(path)
        self._forget(f"grab:{path}")
        return released

    def _reconcile_grabs(self) -> None:
        """Grabbed set := union of every killed group's targets. A device with
        keys held is not grabbed until idle (its key-ups would be swallowed and
        stay stuck at the OS); each key-up re-runs this."""
        desired: set[str] = set()
        for g in self.groups:
            if g.killed:
                desired.update(g.targets)
        changed = False
        for path in desired - self.grabbed:
            if self.pressed.get(path):
                if f"defer:{path}" not in self._said:
                    self._said.add(f"defer:{path}")
                    self._debug(
                        f"deferring grab of {self.devices[path].name} until its keys are released"
                    )
                continue
            changed |= self._grab(path)
        for path in self.grabbed - desired:
            changed |= self._ungrab(path)
        if changed:
            self._release_stale_keys()  # a routing change can swallow an in-flight key-up

    # -- state ---------------------------------------------------------------- #
    def _global_pressed(self) -> set[int]:
        """Union across devices: input-remapper splits one keyboard's keys over
        several virtual devices, so per-device matching would never see a combo."""
        held: set[int] = set()
        for keys in self.pressed.values():
            held |= keys
        return held

    def _sync_latches(self, held: set[int]) -> None:
        for g in self.groups:
            g.kill_held = combo_held(g.kill_combo, held)
            g.wake_held = combo_held(g.wake_combo, held)

    def _toggle_groups(self, held: set[int]) -> None:
        """Rising edge only: a combo fires when it goes from not-held to held and
        re-arms once any part is released. Level-triggering would re-fire on every
        key-down while held (k->l roll-over, kill==wake toggles, a device readable
        both directly and via its remapper copy)."""
        for g in self.groups:
            kill_edge = combo_held(g.kill_combo, held) and not g.kill_held
            wake_edge = combo_held(g.wake_combo, held) and not g.wake_held
            if not g.killed and kill_edge:
                self._set_killed(g, True, "hotkey")
            elif g.killed and wake_edge:
                self._set_killed(g, False, "hotkey")
        self._sync_latches(held)

    def _can_self_wake(self, group: Group) -> bool:
        caps: set[int] = set()
        for d in group.targets.values():
            caps |= set(d.capabilities().get(ecodes.EV_KEY, []))
        return all(token & caps for token in group.wake_combo)

    def _set_killed(self, group: Group, killed: bool, how: str) -> None:
        group.killed = killed
        via = " (via control)" if how == "control" else ""
        if killed:
            if not group.targets:
                self._once(
                    f"notarget:{group.name}",
                    f"[{group.name}] no target device present; will grab one when it appears",
                    PRI_WARN,
                )
            elif not self._can_self_wake(group):
                self._once(
                    f"selfwake:{group.name}",
                    f"[{group.name}] note: cannot wake itself; use the wake hotkey on another device",
                    PRI_WARN,
                )
            log_state(f"[{group.name}] KILLED ({len(group.targets)} device(s)){via}")
        else:
            log_state(f"[{group.name}] AWAKE{via}")
        self._maybe_broadcast()

    # -- events --------------------------------------------------------------- #
    def _process(self, path: str, event) -> None:
        if event.type == ecodes.EV_SYN:
            if event.code == ecodes.SYN_DROPPED:
                self._resync(path)
            return
        if event.type != ecodes.EV_KEY or event.value == 2:  # ignore autorepeat
            return
        pressed = self.pressed[path]
        if event.value == 1:
            pressed.add(event.code)
        else:
            pressed.discard(event.code)
        held = self._global_pressed()
        self._toggle_groups(held)  # on up as well as down: a release re-arms the latch
        self._debug_progress(held, path)
        self._reconcile_grabs()

    def _resync(self, path: str) -> None:
        """The kernel dropped queued events: reload this device's held keys and
        re-latch, so the loss can neither strand a key nor fire a combo."""
        held = active_keys_safe(self.devices[path])
        if held is not None:
            self.pressed[path] = held
        self._sync_latches(self._global_pressed())
        self._debug(f"SYN_DROPPED on {path}; resynced held keys")

    def _debug_progress(self, held: set[int], path: str) -> None:
        if not any(info["debug"] for info in self.clients.values()):
            return
        dev = self.devices.get(path)
        src = dev.name if dev is not None else path
        for g in self.groups:
            if g.killed:
                names = [t.strip() for t in g.wake_raw.split("+") if t.strip()]
                missing = [n for n, tok in zip(names, g.wake_combo) if not (tok & held)]
                self._debug(
                    f"[{g.name}] wake: {len(names) - len(missing)}/{len(names)} tokens held"
                    + (f", missing {'+'.join(missing)}" if missing else "")
                    + f" (last event from {src!r})"
                )

    def _read_device(self, dev: InputDevice, path: str) -> None:
        try:
            for event in dev.read():
                self._process(path, event)
            self._forget(f"read:{path}")
        except OSError as e:
            if e.errno in (errno.ENODEV, errno.EBADF):
                CTRL_LOG.emit(f"device removed mid-read: {path}")
                self._remove_device(path)
                self.need_rescan = True
            elif e.errno != errno.EAGAIN:
                self._once(f"read:{path}", f"read error on {path}: {e}", PRI_WARN)

    # -- control socket ------------------------------------------------------- #
    def _open_control_socket(self) -> None:
        """0666 socket: any local user may connect (a pusher must be able to
        bootstrap); SO_PEERCRED gates every command."""
        path = control_socket_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path):
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                try:
                    probe.connect(path)
                except OSError:
                    os.unlink(path)  # stale file from a dead daemon
                else:
                    raise OSError(
                        errno.EADDRINUSE, f"another daemon is listening on {path}"
                    )
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.bind(path)
        os.chmod(path, 0o666)
        s.listen(MAX_CLIENTS)
        s.setblocking(False)
        self._listen, self._sock_path = s, path
        self.sel.register(s, selectors.EVENT_READ, _LISTEN)
        log(f"control socket: {path}")

    def _state_dict(self) -> dict:
        return {
            "type": "state",
            "groups": [
                {
                    "name": g.name,
                    "label": g.label or g.name,
                    "killed": g.killed,
                    "targets": len(g.targets),
                    "kill": g.kill_raw,
                    "wake": g.wake_raw,
                    "kill_codes": [sorted(tok) for tok in g.kill_combo],
                    "wake_codes": [sorted(tok) for tok in g.wake_combo],
                }
                for g in self.groups
            ],
        }

    def _device_entry(self, path: str, dev: InputDevice, monitored: bool) -> dict:
        front = self._fronting.get(path)
        return {
            "path": path,
            "name": dev.name,
            "class": device_class(dev),
            "virtual": is_virtual(dev),
            "monitored": monitored,
            "grabbed": path in self.grabbed,
            "held_keys": len(self.pressed.get(path, ())),
            "targets": [g.name for g in self.groups if path in g.targets],
            "fronted_by": front[0] if front else None,
        }

    def _devices_dict(self, everything: bool) -> dict:
        entries = [
            self._device_entry(p, d, True) for p, d in sorted(self.devices.items())
        ]
        if everything:
            for path in sorted(set(list_devices()) - self.devices.keys()):
                try:
                    dev = InputDevice(path)
                except OSError:
                    continue
                entries.append(self._device_entry(path, dev, False))
                dev.close()
        return {"type": "devices", "devices": entries}

    def _send(self, conn: socket.socket, obj: dict) -> None:
        try:
            conn.sendall((json.dumps(obj) + "\n").encode())
        except OSError:
            self._drop_client(conn)

    @staticmethod
    def _peer_uid(conn: socket.socket) -> int | None:
        try:
            creds = conn.getsockopt(
                socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
            )
            return struct.unpack("3i", creds)[1]
        except OSError:
            return None

    def _accept_client(self) -> None:
        assert self._listen is not None
        try:
            conn, _ = self._listen.accept()
        except OSError:
            return
        uid = self._peer_uid(conn)
        per_uid = sum(1 for c in self.clients.values() if c["uid"] == uid)
        if (
            uid is None
            or (uid != 0 and per_uid >= MAX_CONNS_PER_UID)
            or len(self.clients) >= MAX_CLIENTS
        ):
            if uid is not None:
                CTRL_LOG.emit(
                    f"control: connection cap reached (uid {uid}), refusing", PRI_WARN
                )
            conn.close()
            return
        conn.setblocking(False)
        self.clients[conn] = {
            "buf": b"",
            "uid": uid,
            "born": time.monotonic(),
            "hello": False,
            "debug": False,
        }
        self.sel.register(conn, selectors.EVENT_READ, ("client", conn))
        if uid in (0, self.live_uid):
            self._send(conn, self._state_dict())

    def _drop_client(self, conn: socket.socket) -> None:
        try:
            self.sel.unregister(conn)
        except (KeyError, ValueError):
            pass
        info = self.clients.pop(conn, None)
        try:
            conn.close()
        except OSError:
            pass
        if info is None or self.forced:
            return
        uid = info["uid"]
        if not any(c["uid"] == uid for c in self.clients.values()) and self.pushed.pop(
            uid, None
        ):
            CTRL_LOG.emit(f"uid {uid} disconnected; dropping its pushed config")
            if uid == self.live_uid:
                self._reevaluate_live()

    def _sweep_handshake(self) -> None:
        now = time.monotonic()
        for conn, info in list(self.clients.items()):
            if not info["hello"] and now - info["born"] > HANDSHAKE_SECONDS:
                CTRL_LOG.emit(
                    f"control: dropping idle connection from uid {info['uid']}",
                    PRI_WARN,
                )
                self._drop_client(conn)

    def _read_client(self, conn: socket.socket) -> None:
        info = self.clients.get(conn)
        if info is None:
            return
        try:
            data = conn.recv(65536)
        except OSError:
            data = b""
        if not data:
            self._drop_client(conn)
            return
        *lines, rest = (info["buf"] + data).split(b"\n")
        if len(rest) > MAX_LINE:
            CTRL_LOG.emit("control: dropping client (over-long line)", PRI_WARN)
            self._drop_client(conn)
            return
        info["buf"] = rest
        for line in lines:
            try:
                obj = json.loads(line) if line.strip() else None
            except ValueError:
                continue
            if isinstance(obj, dict):
                info["hello"] = True
                self._apply_command(obj, conn, info["uid"])

    def _apply_command(self, obj: dict, conn: socket.socket, uid: int) -> None:
        cmd = obj.get("cmd")
        if cmd == "set_config":  # any uid; governs only while that uid is live
            if isinstance(obj.get("toml"), str):
                self._on_set_config(uid, obj["toml"])
            return
        if uid not in (0, self.live_uid):
            CTRL_LOG.emit(
                f"control: rejected {cmd!r} from uid {uid} (not the live user)",
                PRI_WARN,
            )
            self._send(conn, {"type": "error", "error": "not the live user"})
            return
        if cmd == "status":
            self._send(conn, self._state_dict())
        elif cmd == "devices":
            self._send(conn, self._devices_dict(bool(obj.get("all"))))
        elif cmd == "debug":
            if uid != 0:
                self._send(conn, {"type": "error", "error": "debug is root only"})
                return
            self.clients[conn]["debug"] = True
            self._send(
                conn, {"type": "debug", "msg": "subscribed to key-rate diagnostics"}
            )
        elif cmd in ("kill", "wake", "toggle"):
            group = next((g for g in self.groups if g.name == obj.get("group")), None)
            if group is None:
                self._send(conn, {"type": "error", "error": "no such group"})
                return
            want = {"kill": True, "wake": False, "toggle": not group.killed}[cmd]
            if want != group.killed:
                self._set_killed(group, want, "control")
                self._reconcile_grabs()
        else:
            self._send(conn, {"type": "error", "error": f"unknown command {cmd!r}"})

    def _maybe_broadcast(self) -> None:
        """Send state to the live user's clients whenever it changed. Called on
        every kill/wake edge, so no transition is ever coalesced away."""
        sig = tuple((g.killed, len(g.targets)) for g in self.groups)
        if sig == self._last_sig:
            return
        self._last_sig = sig
        state = self._state_dict()
        for conn, info in list(self.clients.items()):
            if info["uid"] in (0, self.live_uid):
                self._send(conn, state)

    # -- main loop ------------------------------------------------------------ #
    def _watch(self, path: str, mask: int, tag: object) -> None:
        w = InotifyWatch(path, mask)
        if w.fd >= 0:
            self.sel.register(w.fd, selectors.EVENT_READ, tag)
            self._watches.append(w)

    def _drain(self, tag: object) -> None:
        for w in self._watches:
            if self.sel.get_key(w.fd).data is tag:
                w.drain()

    def run(self) -> int:
        def _stop(signum: int, frame: object) -> None:
            raise KeyboardInterrupt

        signal.signal(signal.SIGTERM, _stop)
        try:
            self._open_control_socket()
        except OSError as e:
            log(f"FATAL: cannot open control socket: {e}", PRI_ERR)
            return 1
        if self.forced:
            log(f"pinned config (-c): {self.pushed[os.getuid()].source}")
        else:
            log("waiting for a config push from the active user's kb-kill-push")
        self._watch(SEATS_DIR, _SEAT_MASK, _SEATWATCH)
        self._watch(INPUT_DIR, _INPUT_MASK, _INPUTWATCH)
        self._reevaluate_live()
        self.rescan()
        last_scan = time.monotonic()
        try:
            while self.running:
                now = time.monotonic()
                deadline = min(
                    [
                        last_scan + RESCAN_INTERVAL,
                        *(t for t in self._fronted_until.values() if t != math.inf),
                    ]
                )
                for key, _ in self.sel.select(timeout=max(0.0, deadline - now)):
                    tag = key.data
                    if tag is _LISTEN:
                        self._accept_client()
                    elif tag is _SEATWATCH:
                        self._drain(tag)
                        self._reevaluate_live()
                    elif tag is _INPUTWATCH:
                        self._drain(tag)
                        self.need_rescan = True
                    elif isinstance(tag, tuple):
                        self._read_client(tag[1])
                    else:
                        self._read_device(key.fileobj, tag)  # type: ignore[arg-type]
                now = time.monotonic()
                if self.need_rescan or now >= deadline:
                    self.rescan()
                    self._reevaluate_live()
                    self._sweep_handshake()
                    last_scan = now
        except KeyboardInterrupt:
            pass
        finally:
            self.cleanup()
        return 0

    def cleanup(self) -> None:
        for path in list(self.grabbed):
            self._ungrab(path)
        for path in list(self.devices):
            self._remove_device(path)
        for conn in list(self.clients):
            self._drop_client(conn)
        for w in self._watches:
            try:
                self.sel.unregister(w.fd)
            except (KeyError, ValueError):
                pass
            w.close()
        if self._listen is not None:
            try:
                self.sel.unregister(self._listen)
                self._listen.close()
            except (KeyError, ValueError, OSError):
                pass
            if self._sock_path and os.path.exists(self._sock_path):
                try:
                    os.unlink(self._sock_path)
                except OSError:
                    pass
        log("stopped; all devices released")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="kb-kill-daemon",
        description="Disable/enable input devices (keyboards, mice, touchpads) on a global hotkey.",
    )
    parser.add_argument("command", nargs="?", choices=["run"], help=argparse.SUPPRESS)
    parser.add_argument(
        "-c",
        "--config",
        help="pin this config file live (development; bypasses kb-kill-push and seat arbitration)",
    )
    parser.add_argument(
        "-V",
        "--version",
        action="version",
        version=f"kb-kill-daemon {VERSION} ({Path(__file__).resolve()})",
    )
    args = parser.parse_args(argv)
    config = None
    if args.config:
        try:
            config = load_config_file(args.config)
        except ConfigError as e:
            log(str(e), PRI_ERR)
            return 1
    return KbKill(config).run()


if __name__ == "__main__":
    sys.exit(main())
