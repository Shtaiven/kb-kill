            </object></child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
"""


def shortcuts_window() -> Gtk.ShortcutsWindow:
    return Gtk.Builder.new_from_string(SHORTCUTS_UI, -1).get_object("shortcuts")


class ConfigApp(Adw.Application):
    """Single instance: launching it again raises the open window."""

    ACCELS = (
        ("win.save", ["<Primary>s"]),
        ("win.show-help-overlay", ["<Primary>question"]),
        ("window.close", ["<Primary>w"]),
        ("app.quit", ["<Primary>q"]),
    )

    def __init__(self) -> None:
        super().__init__(application_id=APP_ID)
        self._win: ConfigWindow | None = None

    def do_startup(self) -> None:
        Adw.Application.do_startup(self)
        for name, handler in (("about", self._on_about), ("quit", self._on_quit)):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", handler)
            self.add_action(action)
        for action, accels in self.ACCELS:
            self.set_accels_for_action(action, accels)

    def do_activate(self) -> None:
        if self._win is None:
            self._win = ConfigWindow(self)
            GLib.idle_add(self._unfocus)
        self._win.present()

    def _unfocus(self) -> bool:
        """GTK focuses the first entry on map, which selects all its text.
        Start with nothing focused or selected until a click or Tab."""
        focus = self._win.get_focus() if self._win else None
        if isinstance(focus, Gtk.Editable):
            focus.select_region(0, 0)
        if self._win:
            self._win.set_focus(None)
        return False  # one-shot idle

    def _on_about(self, *_args) -> None:
        Adw.AboutDialog(
            application_name="kb-kill",
            application_icon="kb-kill-awake",
            developer_name="Steven Eisinger",
            version=VERSION,
            website="https://github.com/Shtaiven/kb-kill",
            issue_url="https://github.com/Shtaiven/kb-kill/issues",
            license_type=Gtk.License.MIT_X11,
            copyright="© Steven Eisinger",
        ).present(self._win)

    def _on_quit(self, *_args) -> None:
        """Through the window, so unsaved edits still get their prompt."""
        if self._win is not None:
            self._win.close()


def main() -> int:
    # kb-kill-config.desktop names APP_ID as its StartupWMClass: Wayland shells
    # match it to the app id (the GApplication's), X11 ones to WM_CLASS (prgname).
    GLib.set_prgname(APP_ID)
    return ConfigApp().run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
